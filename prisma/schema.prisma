// --- Catalogue des types de débours (tblDebours) ---
model DeboursType {
  id              String   @id @default(cuid())
  cabinetId       String
  nom             String
  categorie       String
  description     String?
  taxable         Boolean  @default(false)
  isGovernment    Boolean  @default(false) // Frais gouvernementaux (IRCC, LTT, etc.) — non-taxable
  gouvernementRef String? // "IRCC", "LTT", "FINTRAC", etc.
  coutDefaut      Float?
  actif           Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  cabinet          Cabinet           @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  deboursDossiers  DeboursDossier[]
  deboursTemplates DeboursTemplate[]

  @@index([cabinetId])
  @@index([cabinetId, categorie])
}

// Statut de cycle de vie d'un débours récupérable (doctrine §5/§9).
//   NON_FACTURE : avancé, pas encore porté sur une facture.
//   FACTURE     : porté sur une facture émise (en attente de recouvrement).
//   RECOUVRE    : la facture le couvrant est entièrement payée.
//   RADIE       : jugé non recouvrable (le cabinet absorbe le coût ; pas de reprise du cash sorti).
enum DeboursStatut {
  NON_FACTURE
  FACTURE
  RECOUVRE
  RADIE
}

// --- Débours par dossier (tblDeboursDossier) ---
model DeboursDossier {
  id             String        @id @default(cuid())
  cabinetId      String
  dossierId      String
  clientId       String
  deboursTypeId  String?
  description    String
  quantite       Float         @default(1)
  montant        Float
  taxable        Boolean       @default(false)
  date           DateTime
  payeParCabinet Boolean       @default(true)
  refacturable   Boolean       @default(true)
  statutDebours  DeboursStatut @default(NON_FACTURE)
  factureId      String?
  invoiceLineId  String?       @unique
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  cabinet     Cabinet      @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  dossier     Dossier      @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  client      Client       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  deboursType DeboursType? @relation(fields: [deboursTypeId], references: [id], onDelete: SetNull)
  facture     Invoice?     @relation(fields: [factureId], references: [id], onDelete: SetNull)
  invoiceLine InvoiceLine? @relation("DeboursDossierInvoiceLine", fields: [invoiceLineId], references: [id], onDelete: SetNull)

  @@index([cabinetId])
  @@index([dossierId])
  @@index([clientId])
  @@index([factureId])
  @@index([cabinetId, date])
  @@index([cabinetId, statutDebours])
}

model ConsentLog {
  id               String    @id @default(cuid())
  clientId         String
  finalites        String // JSON des finalités consenties
  consentementAt   DateTime  @default(now())
  userId           String? // utilisateur ayant enregistré
