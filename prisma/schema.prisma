generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Cabinet {
  id                          String    @id @default(cuid())
  nom                         String
  adresse                     String?
  telephone                   String?
  email                       String?
  logoUrl                     String?
  barreauNumero               String? // LSO#, Barreau# for invoice header
  /// Fin d'exercice financier, format "MM-DD". Toutes les durées de conservation
  /// ancrées sur l'exercice en dépendent : art. 32 QC (7 ans après la fin de
  /// l'exercice) et By-Law 9 s. 23 ON (6 ans / 10 ans précédant la dernière fin
  /// d'exercice). Sans cette donnée, aucune rétention n'est calculable.
  fiscalYearEnd               String?
  /// Date à partir de laquelle le garde-fou d'identité BLOQUE les mouvements de
  /// fonds (art. 26(1) B-1 r.5 / s. 22(1)(b) By-Law 7.1).
  ///
  /// Volontairement une DATE et non un booléen. Un interrupteur booléen se met à
  /// « off » un mardi pour débloquer quelqu'un et y reste deux ans — c'est
  /// exactement ce qui est arrivé à COMPLIANCE_RULES_ENABLED dans ce dépôt. Une
  /// date force à répondre « à partir de quand », affiche un compte à rebours, et
  /// rend l'absence de décision visible plutôt que silencieuse.
  ///
  /// null      → mode observation : le contrôle s'exécute, avertit et journalise,
  ///             mais ne bloque pas. Signalé comme écart de conformité ouvert.
  /// future    → période de régularisation, compte à rebours affiché au cabinet.
  /// atteinte  → blocage effectif.
  identityGateEnforcedFrom    DateTime?
  /// Exige-t-on une pièce justificative pour marquer une identité « vérifiée » ?
  ///
  /// Par défaut OUI (art. 22 B-1 r.5 / s. 23(13) By-Law 7.1). Le réglage existe
  /// parce qu'un cabinet peut avoir des raisons légitimes de ne pas téléverser
  /// (pièces au papier, coffre, système documentaire externe). Il ne dispense PAS
  /// de conserver la pièce : il dispense de la déposer dans SAFE.
  ///
  /// La levée est ATTRIBUÉE : qui, quand, pourquoi. Une dispense anonyme est une
  /// dispense que personne n'assume, et c'est ce qu'un inspecteur cherche.
  identityProofRequired       Boolean   @default(true)
  identityProofWaivedById     String?
  identityProofWaivedAt       DateTime?
  identityProofWaiverReason   String?
  config                      String? // JSON: tauxInteret, devise, formatFacture
  plan                        String    @default("essentiel")
  stripeCustomerId            String?   @unique
  stripeSubscriptionId        String?   @unique
  stripePriceId               String?
  stripeSubscriptionStatus    String?
  stripeCurrentPeriodEnd      DateTime?
  stripeCancelAtPeriodEnd     Boolean   @default(false)
  stripeTrialEnd              DateTime?
  // Stripe Connect (Express) — compte connecté du cabinet pour encaisser les
  // factures en ligne (direct charge : l'argent va direct à l'avocate). ADR-012.
  stripeConnectAccountId      String?   @unique
  stripeConnectChargesEnabled Boolean   @default(false)
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  users                      User[]
  clients                    Client[]
  dossiers                   Dossier[]
  timeEntries                TimeEntry[]
  expenses                   Expense[]
  invoices                   Invoice[]
  invoiceSendLogs            InvoiceSendLog[]
  payments                   Payment[]
  documents                  Document[]
  auditLogs                  AuditLog[]
  documentRetentionPolicies  DocumentRetentionPolicy[]
  trustAccounts              TrustAccount[]
  trustTransactions          TrustTransaction[]
  billingRuns                BillingRun[]
  creditNotes                CreditNote[]
  deboursTypes               DeboursType[]
  deboursDossiers            DeboursDossier[]
  expenseCategories          ExpenseCategory[]
  bankImportSessions         BankImportSession[]
  bankImportTransactions     BankImportTransaction[]
  expenseCategorizationRules ExpenseCategorizationRule[]
  cabinetExpenses            CabinetExpense[]
  journalEntries             JournalGeneralEntry[]
  accountingPeriodLocks      AccountingPeriodLock[]
  employees                  Employee[]
  payrollPeriods             PayrollPeriod[]
  importHistories            ImportHistory[]
  calendarEvents             CalendarEvent[]
  dossierTrustMovements      DossierTrustMovement[]
  dossierReminders           DossierReminder[]
  auditSubmissions           AuditSubmission[]
  interfaceConfig            CabinetInterface?
  trustReconciliations       TrustReconciliation[]
  trustComplianceReports     TrustComplianceReport[]
  notificationLogs           NotificationLog[]
  forfaitServices            ForfaitService[]
  registreTaches             RegistreTache[]
  richDocuments              RichDocument[]
  workSessions               WorkSession[]
  dossierSections            DossierSection[]
  invitations                Invitation[]
  readyForReviewSignals      DossierReadyForReviewSignal[]
  navetteMessages            DossierNavetteMessage[]
  stripeWebhookEvents        StripeWebhookEvent[]
  dossierDocketEntries       DossierDocketEntry[]
  employeeHoursEntries       EmployeeHoursEntry[]

  // --- CRM / Console SAFE Inc. (Spec v1.1) ---
  lead               Lead?                  @relation("CabinetLead")
  tickets            SupportTicket[]        @relation("CabinetTickets")
  conversations      SupportConversation[]  @relation("CabinetConversations")
  impersonationsOnMe ImpersonationSession[] @relation("CabinetImpersonations")
  payerRules         PayerRule[]
  dossierParties     DossierPartie[]
  beneficialOwners     BeneficialOwner[]
  identityAttestations IdentityAttestation[]
  trustBankAccounts    TrustBankAccount[]
  trustCheques         TrustCheque[]
  trustMonthlyReports  TrustMonthlyReport[]
  cashReceipts         CashReceipt[]
  cashRefunds          CashRefund[]
  transferRequisitions ElectronicTrustTransferRequisition[]
  trustSignatories     TrustSignatory[]
  ledgerTransfers      ClientLedgerTransfer[]
  referralFees         ReferralFee[]
  trustProperties      TrustProperty[]
  trustAnnualReports   TrustAnnualReport[]
  trustShortfalls      TrustShortfall[]
  inspectionSessions   InspectionAccessSession[]
  successionPlan       PracticeSuccessionPlan?
  interestRemittances  TrustInterestRemittance[]
}

/// Statut du permis d'exercice. Réf. By-Law 9 s. 2, 2.2, 2.3 (ON) ·
/// B-1 r.5 art. 74 à 82 (QC, cessation d'exercice).
enum LicenceStatus {
  ACTIVE
  SUSPENDED
  BANKRUPT
  REVOKED
  RETIRED
}

enum UserRole {
  admin_cabinet
  avocat
  assistante
  comptabilite
}

model User {
  id                String   @id @default(cuid())
  cabinetId         String
  email             String
  passwordHash      String
  nom               String
  role              UserRole
  defaultHourlyRate Float?
  isBillable        Boolean  @default(true)
  digestOptOut      Boolean  @default(false) // N7b — désactive le digest courriel quotidien
  isInternal        Boolean  @default(false) // équipe SAFE Inc. : accès Console (remplace le check par nom de cabinet)
  // Révocation de sessions (audit 2026-07-28, §M1). Les sessions sont des JWT de
  // 30 jours : sans marqueur, une réinitialisation de mot de passe ou un
  // changement de rôle n'invalidait rien. Tout JWT émis avant cette date est
  // refusé au prochain contrôle.
  sessionsValidFrom DateTime?
  /// Statut du permis. s. 2 et 2.2 By-Law 9 : un titulaire failli ou suspendu ne
  /// peut pas manier de fonds détenus en fiducie. s. 2.3(1) : le suspendu dispose de
  /// 30 jours pour retirer les fonds de ses comptes en fiducie.
  licenceNumber     String?
  licenceStatus     LicenceStatus @default(ACTIVE)
  suspendedFrom     DateTime?
  bankruptSince     DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  cabinet                    Cabinet                 @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  timeEntries                TimeEntry[]
  dossiersResponsable        Dossier[]               @relation("AvocatResponsable")
  dossiersAssistantJuridique Dossier[]               @relation("AssistantJuridiqueDossier")
  documentsUploaded          Document[]
  documentsReviewed          Document[]              @relation("DocumentReviewedBy")
  auditLogs                  AuditLog[]
  consentLogsRecorded        ConsentLog[]
  clientsLawyerInCharge      Client[]                @relation("LawyerInCharge")
  clientsAssignedLawyer      Client[]                @relation("AssignedLawyer")
  clientsAssistantAssigned   Client[]                @relation("AssistantAssigned")
  dossierTachesAssignees     DossierTache[]
  dossierActesAssignees      DossierActe[]
  dossierNotesCreated        DossierNote[]
  invoiceItems               InvoiceItem[]
  invoicesValidated          Invoice[] // factures validées par cet utilisateur
  invoiceSendLogs            InvoiceSendLog[]
  timeEntriesApproved        TimeEntry[]             @relation("TimeEntryApprovedBy")
  bankImportSessionsCreated  BankImportSession[]
  cabinetExpensesCreated     CabinetExpense[]
  journalEntriesCreated      JournalGeneralEntry[]
  employee                   Employee?
  importHistories            ImportHistory[]
  calendarEventsAssigned     CalendarEvent[]         @relation("CalendarEventAssignee")
  calendarEventsCreated      CalendarEvent[]         @relation("CalendarEventCreator")
  mandateResponsable         DossierMandate[]        @relation("MandateAvocatResponsable")
  mandateSubstitut           DossierMandate[]        @relation("MandateAvocatSubstitut")
  trustMovementsValidated    DossierTrustMovement[]  @relation("TrustMovementValidatedBy")
  dossierClosuresClosed      DossierClosure[]        @relation("DossierClosureClosedBy")
  reconciliationsCertified   TrustReconciliation[]   @relation("ReconciliationCertifiedBy")
  complianceReportsGenerated TrustComplianceReport[] @relation("ComplianceReportGeneratedBy")
  complianceReportsCertified TrustComplianceReport[] @relation("ComplianceReportCertifiedBy")
  conflictChecksPerformed    ConflictCheck[]         @relation("ConflictCheckPerformedBy")

  // Signaux "dossier prêt pour revue" — voir docs/product/READY_FOR_REVIEW_SIGNAL.md
  readyForReviewSignalsAsAvocat     DossierReadyForReviewSignal[] @relation("ReadyForReviewSignalAvocat")
  readyForReviewSignalsCreated      DossierReadyForReviewSignal[] @relation("ReadyForReviewSignalCreatedBy")
  readyForReviewSignalsAcknowledged DossierReadyForReviewSignal[] @relation("ReadyForReviewSignalAcknowledgedBy")
  navetteAuthored                   DossierNavetteMessage[]       @relation("NavetteAuthor")
  hoursReviewed                     EmployeeHoursEntry[]          @relation("EmployeeHoursReviewer")

  resetToken       String?
  resetTokenExpiry DateTime?

  // Phase 1 — Atelier de Rédaction
  richDocsCreated  RichDocument[]        @relation("RichDocCreatedBy")
  richDocsEdited   RichDocument[]        @relation("RichDocLastEditedBy")
  richDocsArchived RichDocument[]        @relation("RichDocArchivedBy")
  richDocVersions  RichDocumentVersion[]
  workSessions     WorkSession[]

  // --- CRM / Console SAFE Inc. (Spec v1.1) ---
  leadContact           LeadContact?           @relation("UserLeadContact")
  ticketsCreated        SupportTicket[]        @relation("TicketCreator")
  ticketRepliesAuthored TicketReply[]          @relation("TicketReplyAuthor")
  conversationsCreated  SupportConversation[]  @relation("ConversationCreator")
  messagesAuthored      SupportMessage[]       @relation("MessageAuthor")
  impersonationsByMe    ImpersonationSession[] @relation("Impersonator")
}

enum EmployeeRole {
  ADMIN_ACCOUNTANT
  LEAD_LAWYER
  LAWYER
  LEGAL_ASSISTANT
  ACCOUNTING_TECHNICIAN
  INTERN
  READ_ONLY
}

enum EmployeeStatus {
  active
  inactive
}

enum PayrollFrequency {
  weekly
}

enum PayrollPeriodStatus {
  draft
  closed
}

enum PayslipStatus {
  draft
  generated
  paid
}

enum PayslipAdjustmentType {
  bonus
  deduction
  correction
}

enum EmploymentType {
  employee
  contractor
}

model Employee {
  id               String         @id @default(cuid())
  cabinetId        String
  userId           String?        @unique
  firstName        String
  lastName         String
  fullName         String
  email            String
  phone            String?
  address          String?
  hireDate         DateTime
  status           EmployeeStatus @default(active)
  role             EmployeeRole
  jobTitle         String?
  hourlyRate       Float          @default(0)
  employmentType   EmploymentType @default(employee)
  sinNumero        String? // NAS — affiché masqué dans l'UI
  supervisorId     String?
  responsibilities String? // assigned responsibilities / workflow
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  cabinet      Cabinet              @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  user         User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  supervisor   Employee?            @relation("EmployeeSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  subordinates Employee[]           @relation("EmployeeSupervisor")
  payslips     Payslip[]
  hoursEntries EmployeeHoursEntry[]

  @@index([cabinetId])
  @@index([cabinetId, status])
  @@index([userId])
  @@index([supervisorId])
}

model PayrollPeriod {
  id          String              @id @default(cuid())
  cabinetId   String
  periodStart DateTime
  periodEnd   DateTime
  frequency   PayrollFrequency    @default(weekly)
  status      PayrollPeriodStatus @default(draft)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  cabinet  Cabinet   @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  payslips Payslip[]

  @@index([cabinetId])
  @@index([cabinetId, periodStart])
}

model Payslip {
  id              String        @id @default(cuid())
  employeeId      String
  payrollPeriodId String
  hoursWorked     Float         @default(0)
  hourlyRate      Float
  grossPay        Float         @default(0)
  deductions      Float         @default(0)
  netPay          Float         @default(0)
  status          PayslipStatus @default(draft)
  paymentDate     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  employee     Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  period       PayrollPeriod        @relation(fields: [payrollPeriodId], references: [id], onDelete: Cascade)
  adjustments  PayslipAdjustment[]
  hoursEntries EmployeeHoursEntry[]

  @@index([employeeId])
  @@index([payrollPeriodId])
}

model PayslipAdjustment {
  id          String                @id @default(cuid())
  payslipId   String
  type        PayslipAdjustmentType
  amount      Float
  description String?
  createdAt   DateTime              @default(now())

  payslip Payslip @relation(fields: [payslipId], references: [id], onDelete: Cascade)

  @@index([payslipId])
}

enum TypeClient {
  personne_physique
  personne_morale
}

enum ClientStatus {
  actif
  inactif
  archive
}

enum PreferredContactMethod {
  email
  phone
  mail
}

enum IdType {
  passport
  driver_license
  other
}

enum RepresentationType {
  plaintiff
  defendant
  advisor
}

// Plusieurs personnes sur un dossier (co-clients + parties).
// Doctrine : docs/product/SPEC_MULTI_CLIENTS_PARTIES_DOSSIER.md
enum DossierPartieNature {
  co_client // rattaché à une fiche Client (notre côté : facturable, fiducie)
  partie_externe // nom libre, JAMAIS une fiche Client (adverse ou tiers)
}

enum DossierPartieRole {
  mandant_principal // le client principal du dossier (miroir de Dossier.clientId)
  co_client // autre client de notre côté
  partie_adverse // partie opposée
  tiers // intervenant, témoin, autre partie non adverse
}

enum PreferredPaymentMethod {
  card
  transfer
  trust
  cheque
}

model Client {
  id                          String                  @id @default(cuid())
  cabinetId                   String
  typeClient                  TypeClient              @default(personne_morale)
  status                      ClientStatus            @default(actif)
  raisonSociale               String?
  prenom                      String?
  nom                         String?
  dateNaissance               DateTime?
  numeroRegistreEntreprise    String?
  contact                     String?
  email                       String?
  emailSecondaire             String?
  telephone                   String?
  telephoneSecondaire         String?
  adresse                     String?
  addressLine1                String?
  addressLine2                String?
  city                        String?
  province                    String?
  postalCode                  String?
  country                     String?
  preferredContactMethod      PreferredContactMethod?
  langue                      String? // FR, EN
  nas                         String?
  consentementCollecteAt      DateTime?
  finalitesConsentement       String?
  dateVerificationIdentite    DateTime?
  methodeVerificationIdentite String?
  idType                      IdType?
  idNumber                    String?
  idExpiration                DateTime?
  identityVerified            Boolean                 @default(false)
  verificationDate            DateTime?
  retentionJusqua             DateTime?
  notesConfidentielles        String?
  lawyerInChargeId            String?
  assignedLawyerId            String?
  assistantAssignedId         String?
  representationType          RepresentationType?
  retainerSigned              Boolean                 @default(false)
  retainerDate                DateTime?
  trustAccountBalance         Float                   @default(0)
  trustAccountId              String?
  allowTrustPayments          Boolean                 @default(false)
  lastTrustTransactionDate    DateTime?
  billingContactName          String?
  billingEmail                String?
  billingAddress              String?
  paymentTerms                String?
  preferredPaymentMethod      PreferredPaymentMethod?
  creditLimit                 Float?
  clientCode                  String?
  displayName                 String?
  billingAddressLine1         String?
  billingAddressLine2         String?
  billingCity                 String?
  billingProvince             String?
  billingPostalCode           String?
  billingCountry              String?
  languagePreference          String?
  paymentTermsDays            Int?
  defaultInterestRateAnnual   Float?
  isActive                    Boolean                 @default(true)
  conflictChecked             Boolean                 @default(false)
  conflictCheckDate           DateTime?
  conflictNotes               String?

  // ── CH-06 — identification du client (B-1 r.5 art. 13-14 / By-Law 7.1 s. 23(1))
  /// Occupation. Exigée pour toute personne physique dans les DEUX régimes
  /// (art. 14(1)d QC / s. 23(1)5 ON). Champ absent jusqu'ici : l'obligation ne
  /// pouvait donc pas être satisfaite.
  occupation                  String?
  /// Nature générale des activités d'une société ou d'un organisme
  /// (art. 14(2)d QC / s. 23(1)6 ON).
  natureActivites             String?
  /// Le client agit-il pour un tiers ? Si oui, les mêmes renseignements sont exigés
  /// sur ce tiers (art. 14 al. 3 QC / s. 23(1)8 ON).
  actsForThirdParty           Boolean                 @default(false)
  thirdPartyDetails           String?
  /// Exemption de vérification invoquée (art. 21 QC / s. 22(2)(3)(4) ON), validée
  /// contre la province : une exemption ontarienne n'exempte pas au Québec.
  identityExemption           String?
  identityExemptionJustification String?
  /// Premier mouvement de fonds pour ce client : point de départ du délai de
  /// vérification (60 jours au QC, 30 en ON pour une organisation).
  firstFundsMovementAt        DateTime?
  /// Échéance de vérification calculée. Au-delà, les mouvements sont bloqués.
  identityVerificationDueAt   DateTime?
  documentRefs                String? // JSON: retainer_agreement, id_documents, court_documents, client_correspondence
  createdAt                   DateTime                @default(now())
  updatedAt                   DateTime                @updatedAt

  cabinet               Cabinet                       @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  lawyerInCharge        User?                         @relation("LawyerInCharge", fields: [lawyerInChargeId], references: [id], onDelete: SetNull)
  assignedLawyer        User?                         @relation("AssignedLawyer", fields: [assignedLawyerId], references: [id], onDelete: SetNull)
  assistantAssigned     User?                         @relation("AssistantAssigned", fields: [assistantAssignedId], references: [id], onDelete: SetNull)
  dossiers              Dossier[]
  timeEntries           TimeEntry[]
  expenses              Expense[]
  invoices              Invoice[]
  invoiceSendLogs       InvoiceSendLog[]
  documents             Document[]
  trustAccounts         TrustAccount[]
  trustTransactions     TrustTransaction[]
  identityVerifications ClientIdentityVerification[]
  beneficialOwners      BeneficialOwner[]
  identityAttestations  IdentityAttestation[]
  trustBankAccounts     TrustBankAccount[]
  cashReceipts          CashReceipt[]
  trustProperties       TrustProperty[]
  trustShortfalls       TrustShortfall[]
  consentLogs           ConsentLog[]
  payments              Payment[]
  creditNotes           CreditNote[]
  billingRuns           BillingRun[]
  deboursDossiers       DeboursDossier[]
  journalEntries        JournalGeneralEntry[]
  calendarEvents        CalendarEvent[]               @relation("CalendarEventClient")
  richDocuments         RichDocument[]
  workSessions          WorkSession[]
  readyForReviewSignals DossierReadyForReviewSignal[]
  dossierDocketEntries  DossierDocketEntry[]
  payerRules            PayerRule[]
  dossierParties        DossierPartie[]

  @@index([cabinetId])
  @@index([cabinetId, raisonSociale])
  @@index([cabinetId, status])
  @@index([assignedLawyerId])
}

enum DossierStatut {
  ouvert
  actif
  en_attente
  cloture
  archive
}

enum DossierType {
  droit_famille
  litige_civil
  criminel
  immigration
  immobilier
  corporate
  autre
}

enum ModeFacturationDossier {
  horaire
  forfait
  retainer
  contingent
}

model Dossier {
  id                        String                  @id @default(cuid())
  cabinetId                 String
  clientId                  String
  avocatResponsableId       String?
  assistantJuridiqueId      String?
  reference                 String?
  numeroDossier             String?
  matterCode                String?
  intitule                  String
  statut                    DossierStatut           @default(actif)
  type                      DossierType?
  descriptionConfidentielle String?
  resumeDossier             String?
  notesStrategieJuridique   String?
  tribunalNom               String?
  districtJudiciaire        String?
  numeroDossierTribunal     String?
  nomJuge                   String?
  modeFacturation           ModeFacturationDossier?
  tauxHoraire               Float?
  soldeFiducieDossier       Float?                  @default(0)
  autoriserPaiementFiducie  Boolean                 @default(false)
  dateOuverture             DateTime                @default(now())
  dateCloture               DateTime?
  retentionJusqua           DateTime?

  // Immobilier-specific fields (D2)
  sousType            String? // "achat" | "vente" | "condo" | "hypotheque" | "ee" | "parrainage" | "travail" | "appel"
  closingDate         DateTime?
  propertyAddress     String?
  fintracVerified     Boolean   @default(false)
  fintracVerifiedAt   DateTime?
  fintracVerifiedById String?
  fintracDocuments    String? // JSON: { doc1: "type", doc2: "type" }
  condoPINParking     String?
  condoPINLocker      String?

  // Immigration-specific fields (D3)
  irccStatut         String? // "consultation" | "preparation" | "soumission" | "biometrie" | "suivi" | "decision" | "cloture"
  irccNumDossier     String? // IRCC application number
  itaDate            DateTime? // Date ITA reçu (Express Entry — 60j deadline)
  submissionDeadline DateTime? // Calculé auto: itaDate + 60j
  cnpCode            String? // National Occupation Classification
  cnpValidated       Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cabinet               Cabinet                       @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  client                Client                        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  avocatResponsable     User?                         @relation("AvocatResponsable", fields: [avocatResponsableId], references: [id], onDelete: SetNull)
  assistantJuridique    User?                         @relation("AssistantJuridiqueDossier", fields: [assistantJuridiqueId], references: [id], onDelete: SetNull)
  timeEntries           TimeEntry[]
  expenses              Expense[]
  documents             Document[]
  taches                DossierTache[]
  evenements            DossierEvenement[]
  actesLexTrack         DossierActe[]
  notes                 DossierNote[]
  invoices              Invoice[]
  invoiceSendLogs       InvoiceSendLog[]
  trustAccounts         TrustAccount[]
  trustTransactions     TrustTransaction[]
  invoiceLines          InvoiceLine[]
  deboursDossiers       DeboursDossier[]
  cabinetExpenses       CabinetExpense[]
  journalEntries        JournalGeneralEntry[]
  calendarEvents        CalendarEvent[]               @relation("CalendarEventDossier")
  clientInfo            DossierClientInfo?
  mandate               DossierMandate?
  pieces                DossierPiece[]
  procedures            DossierProcedure[]
  judgments             DossierJudgment[]
  correspondence        DossierCorrespondence[]
  trustMovements        DossierTrustMovement[]
  closure               DossierClosure?
  reminders             DossierReminder[]
  immigrationBackground ImmigrationBackground?
  immigrationDocuments  ImmigrationDocument[]
  conflictChecks        ConflictCheck[]
  notificationLogs      NotificationLog[]
  billingStages         DossierBillingStage[]
  registreTaches        RegistreTache[]
  richDocuments         RichDocument[]
  workSessions          WorkSession[]
  sections              DossierSection[]
  readyForReviewSignals DossierReadyForReviewSignal[]
  docketEntries         DossierDocketEntry[]
  navetteMessages       DossierNavetteMessage[]
  employeeHoursEntries  EmployeeHoursEntry[]
  parties               DossierPartie[]

  @@unique([cabinetId, numeroDossier])
  @@index([cabinetId])
  @@index([cabinetId, clientId])
  @@index([cabinetId, statut])
  @@index([cabinetId, type])
  @@index([avocatResponsableId])
  @@index([assistantJuridiqueId])
}

model DossierClientInfo {
  id                  String    @id @default(cuid())
  dossierId           String    @unique
  nasEncrypted        String?
  dateNaissance       DateTime? @db.Date
