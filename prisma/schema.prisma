// --- Rapprochement fidéicommis (By-Law 9 / B-1 r.5) ---
model TrustReconciliation {
  id        String  @id @default(cuid())
  cabinetId String
  cabinet   Cabinet @relation(fields: [cabinetId], references: [id], onDelete: Cascade)

  /// Compte bancaire rapproché. La s. 18(8)ii ON exige « a detailed reconciliation
  /// made monthly of EACH trust bank account » : un rapprochement global sur
  /// plusieurs comptes ne satisfait ni l'Ontario ni l'art. 36 québécois.
  /// Nullable le temps de la reprise.
  trustBankAccountId String?
  trustBankAccount   TrustBankAccount? @relation(fields: [trustBankAccountId], references: [id], onDelete: Restrict)

  periode String // "2026-04" (YYYY-MM)

  // Données 3-way reconciliation
  soldeBancaire        Float // Solde selon relevé bancaire
  chequesEnCirculation Float @default(0) // Chèques émis non encaissés
  depotsEnTransit      Float @default(0) // Dépôts non encore crédités
  soldeRapproche       Float // soldeBancaire - chequesEnCirculation + depotsEnTransit
  soldeRegistre        Float // Somme transactions SAFE (source de vérité)
  soldeParDossier      Float // Somme des soldes de cartes-clients dérivés du registre append-only
  ecart                Float @default(0) // soldeRapproche - soldeRegistre (doit être 0)

  /// TROISIÈME VOIE (CH-00, écart P-1). Écart entre la somme des cartes-clients
  /// (dérivée du registre append-only) et le solde du registre. Doit être 0 pour
  /// certifier. Sans ce champ, la « comparaison à trois voies » annoncée au client
  /// n'en comparait que deux : art. 41(5) QC exige l'état comparatif, et
  /// s. 18(8) ON exige explicitement la liste détaillée par client en appui.
  ecartCartesClients   Float @default(0)

  /// PR-3 — liste sérialisée des contrôles RÉELLEMENT exécutés au moment de la
  /// certification. Le texte de l'attestation est généré à partir de cette liste :
  /// on ne fait jamais signer plus large que ce que le système a vérifié.
  verifiedControlsJson String?
  /// Texte exact de l'attestation signée, figé (PR-5).
  declarationText      String?

  // Certification par l'avocat
  certifiedAt   DateTime?
  certifiedById String?
  certifiedBy   User?     @relation("ReconciliationCertifiedBy", fields: [certifiedById], references: [id], onDelete: SetNull)

  // Intérêts Law Foundation of Ontario / Barreau
  interetsLFO     Float     @default(0)
  interetsPayesAt DateTime?

  status String  @default("draft") // "draft" | "complete" | "certified"
  notes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  complianceReports TrustComplianceReport[]

  /// Un rapprochement PAR COMPTE et par période. La s. 18(8)ii By-Law 9 exige
  /// « a detailed reconciliation made monthly of EACH trust bank account », et
  /// l'art. 36 B-1 r.5 des livres distincts par compte général : un cabinet à deux
  /// comptes doit donc pouvoir produire deux rapprochements pour le même mois.
  /// L'ancienne contrainte `[cabinetId, periode]` le rendait impossible.
  ///
  /// Nuance Postgres : deux NULL sont considérés distincts, donc la contrainte ne
  /// protège pas les rapprochements antérieurs à la reprise. Elle protège tous ceux
  /// créés une fois les comptes saisis, ce qui est le cas visé.
  @@unique([cabinetId, trustBankAccountId, periode])
  @@index([cabinetId])
  @@index([cabinetId, status])
  @@index([trustBankAccountId, periode])
}

// --- Rapport conformité fidéicommis (PDF exportable) ---
model TrustComplianceReport {
  id        String  @id @default(cuid())
  cabinetId String
  cabinet   Cabinet @relation(fields: [cabinetId], references: [id], onDelete: Cascade)

  periode       String // "2026-04"
  type          String   @default("monthly") // "monthly" | "quarterly" | "annual"
  generatedAt   DateTime @default(now())
  generatedById String
  generatedBy   User     @relation("ComplianceReportGeneratedBy", fields: [generatedById], references: [id], onDelete: SetNull)

  pdfUrl String? // URL Supabase Storage
  status String  @default("draft") // "draft" | "final"
  data   String? // JSON: snapshot transactions

  // Déclaration de conformité signée par l'avocat responsable (rapport annuel Barreau).
  certifiedById   String?
  certifiedBy     User?     @relation("ComplianceReportCertifiedBy", fields: [certifiedById], references: [id], onDelete: SetNull)
  certifiedAt     DateTime?
  declarationText String? // texte de l'attestation signée (snapshot)

  reconciliationId String?
  reconciliation   TrustReconciliation? @relation(fields: [reconciliationId], references: [id], onDelete: SetNull)

  @@index([cabinetId])
  @@index([cabinetId, periode])
}

