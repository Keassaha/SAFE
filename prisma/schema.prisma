// ========== Module Calendrier (événements / rendez-vous) ==========

enum CalendarEventType {
  rendez_vous_client
  audience
  reunion_interne
  echeance
  rappel
  autre
}

enum CalendarEventStatus {
  planifie
  confirme
  annule
  termine
}

model CalendarEvent {
  id          String              @id @default(cuid())
  cabinetId   String
  title       String
  description String?
  type        CalendarEventType   @default(rendez_vous_client)
  status      CalendarEventStatus @default(planifie)
  date        DateTime
  startTime   String? // HH:mm
  endTime     String? // HH:mm
  allDay      Boolean             @default(false)

  /// Art. 7 B-1 r.5 — nature juridique de l'échéance.
  ///
  /// « L'avocat doit tenir un système à jour de rappel des dates de prescription et de
  /// tout délai influant sur les recours. »
  ///
  /// PRESCRIPTION | PROCEDURE | CONTRACTUAL | INTERNAL. Le `type` existant dit à quoi
  /// ressemble l'événement ; cette colonne dit ce qu'il coûte de le manquer. Une
  /// prescription manquée éteint le droit du client : ce n'est pas un retard.
  ///
  /// ⚠️ SAISIE HUMAINE, JAMAIS DEVINÉE. Classer une échéance d'après son intitulé
  /// afficherait un faux calme quand on se trompe dans un sens, et noierait les vraies
  /// prescriptions sous des alertes critiques quand on se trompe dans l'autre. Tant que
  /// la colonne est nulle, l'échéance est traitée comme un rappel interne.
  deadlineKind String?

  location    String?
  clientId    String?
  dossierId   String?
  assigneeId  String?
  createdById String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  cabinet   Cabinet  @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  client    Client?  @relation("CalendarEventClient", fields: [clientId], references: [id], onDelete: SetNull)
  dossier   Dossier? @relation("CalendarEventDossier", fields: [dossierId], references: [id], onDelete: SetNull)
  assignee  User?    @relation("CalendarEventAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy User?    @relation("CalendarEventCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([cabinetId])
  @@index([cabinetId, date])
  @@index([cabinetId, assigneeId])
  @@index([clientId])
  @@index([dossierId])
}

