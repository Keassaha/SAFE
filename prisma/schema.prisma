  dateTelechargement DateTime  @default(now())
  dateAcces          DateTime?
  tempsDepenseSec    Int?
  pageScrollPercent  Int?

  declanche_dm         Boolean   @default(false)
  datePropositionAudit DateTime?
}

// ContentPiece : posts LinkedIn, blogs SEO, etc.
model ContentPiece {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  type            TypeContent
  titre           String
  url             String?
  datePublication DateTime?

  vues         Int @default(0)
  likes        Int @default(0)
  commentaires Int @default(0)
  partages     Int @default(0)
  clicsSortie  Int @default(0)

  engagements LinkedInEngagement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LinkedInEngagement {
  id        String       @id @default(cuid())
  contentId String
  content   ContentPiece @relation(fields: [contentId], references: [id])
  leadId    String?
  lead      Lead?        @relation(fields: [leadId], references: [id])
  contactId String?
  contact   LeadContact? @relation(fields: [contactId], references: [id])

  type    TypeEngagement
  contenu String?
  date    DateTime       @default(now())

  utiliseEnDM Boolean   @default(false)
  dateDM      DateTime?
}

// --- Couche 2 : Delivery (lien pipeline 3 phases) ---

model BundleRecommendation {
  id     String @id @default(cuid())
  leadId String @unique
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  bundleRecommande   BundleId
  confidence         Int
  overridesPropose   String? // JSON
  customTriggers     String? // JSON
  consultationTopics String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ConsultationPhase2 {
  id     String @id @default(cuid())
  leadId String @unique
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  dateConsultation     DateTime?
  durationMinutes      Int?
  participants         String[]
  notes                String?
  blockingIntegrations String[]
  exceptionsValidees   String? // JSON

  statut    StatutConsultation @default(A_PLANIFIER)
  createdAt DateTime           @default(now())
}

model ConsultationDecision {
  id     String @id @default(cuid())
  leadId String @unique
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  bundleFinal        BundleId
  overridesValides   String? // JSON
  customItems        String? // JSON
  activationPriority CrmPriorite
  dateDecision       DateTime    @default(now())
  decisionPar        String?
}

model ActivationChecklist {
  id     String @id @default(cuid())
  leadId String @unique
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  envEtConfig            Boolean @default(false)
  cabinetInterfaceConfig String? // JSON
  seedsAppliques         Boolean @default(false)
  utilisateursCreated    Boolean @default(false)
  integrationsTestees    String? // JSON
  documentsTemplates     Boolean @default(false)
  permissionsConfigured  Boolean @default(false)
  parcoursUserTeste      Boolean @default(false)
  risquesResiduels       String?
  remiseAccesFait        Boolean @default(false)

  dateGoLive DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

// --- Couche Console v1.1 : Tickets + Impersonation (ADR-007, ADR-008) ---

model SupportTicket {
  id          String  @id @default(cuid())
  cabinetId   String
  cabinet     Cabinet @relation("CabinetTickets", fields: [cabinetId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User    @relation("TicketCreator", fields: [createdById], references: [id])

  type        TypeTicket
  titre       String
  description String
  priorite    CrmPriorite  @default(NORMALE)
  statut      StatutTicket @default(NOUVEAU)

  contexteUrl        String?
  screenshotUrl      String?
  consoleLogs        String?
  assigneeId         String?
  dateResolution     DateTime?
  noteResolution     String?
  satisfactionRating Int?

  // Origine : billet dérivé d'une conversation de chat (le cas échéant)
  conversationId  String?
  conversation    SupportConversation? @relation("ConversationTickets", fields: [conversationId], references: [id], onDelete: SetNull)
  sourceMessageId String?
  sourceMessage   SupportMessage?      @relation("MessageDerivedTickets", fields: [sourceMessageId], references: [id], onDelete: SetNull)

  replies TicketReply[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cabinetId, statut])
  @@index([statut, priorite])
  @@index([conversationId])
}

/// Fil de discussion (chat) entre un cabinet client et SAFE Inc.
/// Plusieurs fils par cabinet (un par sujet). Bidirectionnel.
model SupportConversation {
  id          String  @id @default(cuid())
  cabinetId   String
  cabinet     Cabinet @relation("CabinetConversations", fields: [cabinetId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User    @relation("ConversationCreator", fields: [createdById], references: [id])

  sujet  String
  statut StatutConversation @default(OUVERTE)

  lastMessageAt DateTime @default(now())

  messages SupportMessage[]
  tickets  SupportTicket[]  @relation("ConversationTickets")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cabinetId, statut])
  @@index([lastMessageAt])
}

/// Message individuel dans un fil de discussion.
model SupportMessage {
  id             String              @id @default(cuid())
  conversationId String
  conversation   SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  authorId       String
  author         User                @relation("MessageAuthor", fields: [authorId], references: [id])

  isFromSafeInc Boolean   @default(false)
  contenu       String
  attachements  String[]
  readAt        DateTime?

  // Billets dérivés de ce message (transformation en billet côté CRM)
  derivedTickets SupportTicket[] @relation("MessageDerivedTickets")
  // Pièces jointes (images, PDF, Word…) stockées sur Vercel Blob privé
  pieces SupportAttachment[]

  createdAt DateTime @default(now())

  @@index([conversationId, createdAt])
}

/// Pièce jointe d'un message de chat. Le fichier est sur Vercel Blob (privé),
/// servi uniquement via route authentifiée. storageKey = clé Blob.
model SupportAttachment {
  id         String         @id @default(cuid())
  messageId  String
  message    SupportMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  nom        String
  mimeType   String
  sizeBytes  Int
  storageKey String
  createdAt  DateTime       @default(now())

  @@index([messageId])
}

model TicketReply {
  id            String        @id @default(cuid())
  ticketId      String
  ticket        SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId      String
  author        User          @relation("TicketReplyAuthor", fields: [authorId], references: [id])
  isFromSafeInc Boolean       @default(false)
  contenu       String
  attachements  String[]
  createdAt     DateTime      @default(now())
}

model ImpersonationSession {
  id           String  @id @default(cuid())
  superadminId String
  superadmin   User    @relation("Impersonator", fields: [superadminId], references: [id])
  cabinetId    String
  cabinet      Cabinet @relation("CabinetImpersonations", fields: [cabinetId], references: [id])

  startedAt    DateTime  @default(now())
  endedAt      DateTime?
  reason       String?
  actionsCount Int       @default(0)
  ipAddress    String?
  userAgent    String?

  @@index([cabinetId, startedAt])
}
