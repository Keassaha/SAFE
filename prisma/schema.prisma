model InvoiceLine {
  id                String                 @id @default(cuid())
  invoiceId         String
  timeEntryId       String?
  description       String
  quantite          Float
  tauxUnitaire      Float
  montant           Float
  lineType          InvoiceLineType?       @default(fee)
  sourceType        InvoiceLineSourceType? @default(manual)
  sourceId          String?
  matterId          String?
  serviceDate       DateTime?
  lineSubtotal      Float?
  taxable           Boolean                @default(true)
  gstAmount         Float                  @default(0)
  qstAmount         Float                  @default(0)
  lineTotal         Float?
  sortOrder         Int                    @default(0)
  validationComment String? // instructions / commentaires par ligne pour la page de validation
  // Rabais canoniques (cf. doctrine refonte facturation phase 1) :
  // - parentLineId pointe sur la ligne d'honoraires/débours rabattue (self-relation).
  // - discountReason est la raison libre affichable au client (ex. "Courtoisie professionnelle").
  // Une ligne de rabais a typiquement lineType="adjustment" et un montant négatif.
  parentLineId      String?
  discountReason    String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @default(now()) @updatedAt

  invoice         Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  timeEntry       TimeEntry?       @relation("TimeEntryAsSource", fields: [timeEntryId], references: [id], onDelete: SetNull)
  matter          Dossier?         @relation(fields: [matterId], references: [id], onDelete: SetNull)
  timeEntryRef    TimeEntry?       @relation("InvoiceLineRef")
  expenses        Expense[]
  deboursDossier  DeboursDossier?  @relation("DeboursDossierInvoiceLine")
  registreTache   RegistreTache?   @relation("RegistreTacheInvoiceLine")
  interestCharges InterestCharge[]
  rabaisItems     InvoiceItem[]
  parentLine      InvoiceLine?     @relation("InvoiceLineDiscount", fields: [parentLineId], references: [id], onDelete: SetNull)
  discountLines   InvoiceLine[]    @relation("InvoiceLineDiscount")

  @@index([invoiceId])
  @@index([timeEntryId])
  @@index([matterId])
  @@index([parentLineId])
}

model InvoiceItem {
  id                      String          @id @default(cuid())
  invoiceId               String
  type                    InvoiceItemType
  description             String
  date                    DateTime
  hours                   Float? // pour honoraires (durée en heures)
  rate                    Float? // pour honoraires (taux horaire)
  amount                  Float
  userId                  String? // professionnel pour honoraires
  professionalDisplayName String? // nom affiché si différent de user
  timeEntryId             String?
  parentItemId            String? // pour rabais : ligne d'honoraire (InvoiceItem) parente
  parentLineId            String? // pour rabais : ligne d'honoraire (InvoiceLine) parente
  validationComment       String? // instructions / commentaires par ligne pour la validation
  createdAt               DateTime        @default(now())

  invoice       Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  user          User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  timeEntry     TimeEntry?    @relation(fields: [timeEntryId], references: [id], onDelete: SetNull)
  parentItem    InvoiceItem?  @relation("RabaisParentItem", fields: [parentItemId], references: [id], onDelete: Cascade)
  rabaisEnfants InvoiceItem[] @relation("RabaisParentItem")
  parentLine    InvoiceLine?  @relation(fields: [parentLineId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([type])
  @@index([parentItemId])
  @@index([parentLineId])
}

model Payment {
  id                String                @id @default(cuid())
  cabinetId         String
  clientId          String? // requis pour nouveaux paiements; dérivé de facture si absent
  invoiceId         String?
  montant           Float
  datePaiement      DateTime
  mode              String?
  method            PaymentMethod         @default(autre)
  reference         String?
  paymentMethod     PaymentMethodBilling? @default(other)
  referenceNumber   String?
  sourceAccountType SourceAccountType?    @default(operating)
  allocationStatus  AllocationStatus      @default(UNALLOCATED)
  note              String?
  receivedById      String?
  // Origine du paiement : "stripe" | "interac" | "cash" | null (saisie manuelle
  // historique). `providerRef` = référence externe (ex. Stripe PaymentIntent id,
  // n° de réf Interac) pour la traçabilité et l'idempotence anti-doublon. ADR-012.
  provider          String?
  providerRef       String?
  // Import intelligent de preuve de paiement (Interac) — lot L4.
  preuveStorageKey  String? // clé de l'image/PDF de preuve conservée
  preuveExtractedAt DateTime? // trace : paiement issu d'une extraction IA
  preuveHash        String? // SHA-256 du fichier de preuve — anti-doublon par contenu
  payerName         String? // payeur réel si tiers (source des fonds, distinct du client)
  payerEmail        String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @default(now()) @updatedAt

  cabinet            Cabinet             @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  client             Client?             @relation(fields: [clientId], references: [id], onDelete: SetNull)
  invoice            Invoice?            @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  paymentAllocations PaymentAllocation[]

  @@unique([cabinetId, providerRef]) // idempotence : un PaymentIntent → un seul Payment
  @@unique([cabinetId, preuveHash]) // anti-doublon : un même fichier de preuve → un seul Payment
  @@index([cabinetId])
  @@index([clientId])
  @@index([invoiceId])
  @@index([allocationStatus])
}

model PaymentAllocation {
  id              String   @id @default(cuid())
  paymentId       String
  invoiceId       String
  allocatedAmount Float
  allocatedAt     DateTime @default(now())
  createdAt       DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([invoiceId])
}

/// Règle de payeur tiers : rattache un payeur (parent, employeur, assureur...) au
/// client pour qui il paie. Import intelligent de preuve de paiement — lot L5.
/// `payerName` est stocké NORMALISÉ (sans accents, minuscules) pour le matching.
model PayerRule {
  id          String         @id @default(cuid())
  cabinetId   String
  payerEmail  String? // au moins un des deux identifiants
  payerName   String? // normalisé
  clientId    String? // cible (requis pour CLIENT_UNIQUE)
  dossierId   String? // optionnel : précise le dossier
  scope       PayerRuleScope
  note        String? // ex: « Père de la cliente », « Assureur Intact »
  active      Boolean        @default(true)
  source      String? // "manuel" | "appris"
  createdById String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @default(now()) @updatedAt

  cabinet Cabinet @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  client  Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([cabinetId, payerEmail])
  @@index([cabinetId])
}

enum PayerRuleScope {
  CLIENT_UNIQUE // ce payeur paie toujours pour CE client → résolution auto
  PAYEUR_CONNU // payeur tiers multi-clients → reconnaissance seule, client choisi par montant
}

enum InvoiceReminderType {
  rappel_only // J+5, J+15 : email rappel uniquement
  frais // J+10 : 5$ frais + envoi facture + écriture dossier
  frais_et_interets // J+20, J+30... : 5$ + intérêts 14%/an + envoi + écriture
}

model InvoiceReminder {
  id             String               @id @default(cuid())
  invoiceId      String
  reminderDay    Int? // 5, 10, 15, 20, 30, 40...
  type           InvoiceReminderType?
  reminderType   ReminderType? // reminder_1, reminder_2, final_notice, interest_notice
  scheduledAt    DateTime?
  sentAt         DateTime?
  status         String?
  channel        ReminderChannel? // email, manual, printed
  amountFrais    Float?
  amountInterets Float?
  note           String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([invoiceId, sentAt])
}

// Trace d'envoi initial d'une facture officielle (séparé de InvoiceReminder qui couvre les relances).
// Une entrée par tentative d'envoi : succès comme échec. Source de vérité de l'historique d'envoi
// affiché dans la fiche client et l'éditeur de facture.
model InvoiceSendLog {
  id             String    @id @default(cuid())
  invoiceId      String
  cabinetId      String
  clientId       String
  dossierId      String?
  sentById       String?
  recipientEmail String
  subject        String
  body           String?
  status         String    @default("sent") // "sent" | "failed" | "queued"
  errorMessage   String?
  pdfUrl         String?
  attachmentName String?
  attachmentSize Int?
  sentAt         DateTime?
  createdAt      DateTime  @default(now())

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  cabinet Cabinet  @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  client  Client   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  dossier Dossier? @relation(fields: [dossierId], references: [id], onDelete: SetNull)
  sentBy  User?    @relation(fields: [sentById], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([cabinetId])
  @@index([clientId])
  @@index([dossierId])
  @@index([invoiceId, createdAt])
}

/// Compte bancaire en fidéicommis.
///
/// C'est l'entité qui manquait à SAFE. `TrustAccount` n'est PAS un compte bancaire :
/// c'est le sous-compte d'un client pour un dossier, autrement dit la carte-client.
/// Le règlement, lui, raisonne par compte bancaire :
///
///   art. 36 QC   — « livres, journaux et registres DISTINCTS pour chaque compte
///                   général en fidéicommis » ;
///   art. 41(7)   — copie du relevé de l'institution POUR CHAQUE compte général ;
///   art. 42(6)(7)— liste des comptes particuliers, et des comptes fermés ;
///   s. 7(5) ON   — « A licensee may keep one or more trust accounts » ;
///   s. 18(8)ii   — « A detailed reconciliation made monthly of EACH trust bank account » ;
///   s. 9(3) ON   — jamais plus que ce qui est détenu pour ce client DANS CE COMPTE.
///
/// Sans cette entité, un cabinet à deux comptes en fidéicommis mélange deux banques
/// dans un seul écart de rapprochement, et aucun des rapports réglementaires n'est
/// produisible.
/// Registre des chèques tirés sur un compte en fidéicommis.
///
/// Art. 61 B-1 r.5 : les chèques « doivent porter le nom de l'avocat ou de la société
/// au sein de laquelle il exerce, suivi de la mention "en fidéicommis" ou "in trust"
/// et ils doivent être NUMÉROTÉS CONSÉCUTIVEMENT ».
/// Art. 57 al. 2 : ils « ne peuvent être payables au porteur, à l'ordre de "caisse",
/// de "cash" ou être faits en blanc ».
/// s. 11(a) By-Law 9 : « shall not be made payable either to cash or to bearer ».
///
/// L'art. 41(2) exige au rapport mensuel la liste des chèques EN CIRCULATION avec,
/// pour chacun, le montant, la date d'émission, le numéro, le nom du client et le
/// numéro de dossier. Sans ce registre, cette liste est impossible à produire :
/// c'est pourquoi elle était réduite à un simple nombre saisi à la main.
/// Rapport comptable mensuel — LE livrable de l'inspection.
///
/// Art. 40 B-1 r.5 : « L'avocat doit tenir à jour un registre permanent contenant les
/// rapports comptables mensuels de chaque compte général en fidéicommis. »
/// Art. 41 : sur le formulaire prescrit par le Comité exécutif, SEPT blocs, dont
/// quatre sont des LISTES DÉTAILLÉES ligne par ligne.
/// s. 18(8) By-Law 9 : comparaison mensuelle « together with the reasons for any
/// differences », appuyée par (i) une liste détaillée par client et (ii) un
/// rapprochement détaillé de chaque compte bancaire.
/// s. 22(2) : créé dans les 25 jours suivant la fin du mois.
///
/// Avant CH-03, SAFE stockait `chequesEnCirculation` et `depotsEnTransit` comme deux
/// nombres flottants saisis à la main. Aucune ligne n'existait. C'est ce qui rendait
/// le rapport de l'art. 41 impossible à produire, et donc l'inspection insurvivable.
/// Reçu d'une somme reçue en espèces.
///
/// Art. 70 B-1 r.5 : « L'avocat doit remettre à la personne de qui il reçoit une
/// somme en espèces un reçu dont il conserve une copie », portant six mentions et
/// signé par l'avocat ET par la personne de qui provient la somme.
/// s. 19(1) By-Law 9 : « a book of duplicate receipts », mêmes mentions moins
/// l'objet, mêmes signatures.
///
/// **Aucun seuil.** Les deux textes visent « une somme en espèces » / « every
/// licensee who receives cash ». Un reçu est exigé pour 50 $ comme pour 50 000 $.
/// Réquisition de virement électronique — Formulaire 9A.
///
/// s. 12(2)4 By-Law 9 : « **BEFORE** any data describing the details of the transfer
/// or authorizing the financial institution to carry out the transfer is entered into
/// the electronic trust transfer system, an electronic trust transfer requisition
/// must be signed. » s. 12(7) : elle est au Formulaire 9A.
/// s. 18(11) : réquisitions signées et confirmations imprimées signées, conservées
/// dix ans (s. 23(2)).
///
/// ⚠️ ONTARIO SEULEMENT. B-1 r.5 n'a aucun équivalent : l'art. 58 permet le virement
/// vers un compte non fiduciaire au nom de l'avocat, sans réquisition ni double
/// contrôle. Imposer ce modèle à un cabinet québécois inventerait une obligation.
model ElectronicTrustTransferRequisition {
  id                 String   @id @default(cuid())
  cabinetId          String
  trustBankAccountId String
  /// 9A (virement courant) · 9B / 9C (fonds de clôture immobilière, s. 13).
  formType           String   @default("9A")

  clientName             String
  dossierRef             String?
  amount                 Float
  recipientName          String
  recipientInstitution   String
  recipientBranch        String?
  recipientBranchAddress String?
  recipientAccountNumber String
  purpose                String

  /// s. 12(2)4 — signée AVANT toute saisie. L'ordre est vérifié, pas seulement
  /// l'existence : une réquisition signée après coup régularise, elle ne vérifie pas.
  signedByUserId String
  signedAt       DateTime

  /// s. 12(2)1 — deux personnes DISTINCTES, deux mots de passe. Le praticien
  /// véritablement seul en est dispensé (s. 12(3)), et l'exemption est consignée.
  dataEnteredByUserId       String?
  dataEnteredAt             DateTime?
  authorizedByUserId        String?
  authorizedAt              DateTime?
  solePractitionerExemption Boolean   @default(false)

  /// s. 12(2)3 — les six éléments que la confirmation doit porter.
  confirmationDocumentId           String?
  confirmationReceivedAt           DateTime?
  confirmationSourceAccount        String?
  confirmationRecipientInstitution String?
  confirmationRecipientName        String?
  confirmationRecipientAccount     String?
  confirmationInstitutionReceivedAt DateTime?
  confirmationSentAt               DateTime?

  /// s. 12(5) — imprimer, comparer, annoter, signer et dater, au plus tard à la
  /// clôture du jour bancaire suivant l'envoi de la confirmation.
  countersignDueAt      DateTime?
  printedAt             DateTime?
  comparedAt            DateTime?
  annotatedClientId     String?
  annotatedDossierId    String?
  countersignedByUserId String?
  countersignedAt       DateTime?

  trustTransactionId String?  @unique
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  cabinet          Cabinet          @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  trustBankAccount TrustBankAccount @relation(fields: [trustBankAccountId], references: [id], onDelete: Restrict)

  @@index([cabinetId])
  @@index([cabinetId, countersignedAt])
  @@index([trustBankAccountId, signedAt])
}

/// Pouvoir de signature sur un compte en fiducie, et cautionnement.
///
/// s. 11(b) By-Law 9 : un non-titulaire ne peut signer un chèque en fiducie que dans
/// des circonstances exceptionnelles, s'il a le pouvoir de signature ET s'il est
/// « bonded in an amount **at least equal to the maximum balance on deposit during
/// the immediately preceding fiscal year** of the licensee in all the trust accounts
/// on which signing authority has been delegated to the person ».
/// s. 12(2)4ii reprend la même condition pour signer une réquisition de virement.
///
/// Le montant du cautionnement n'est donc pas arbitraire : il se calcule.
model TrustSignatory {
  id                 String   @id @default(cuid())
  cabinetId          String
  userId             String
  trustBankAccountId String
  isLicensee         Boolean  @default(true)

  bondAmount     Float?
  bondExpiryDate DateTime?
  bondDocumentId String?

  authorizedFrom DateTime
  authorizedTo   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  cabinet          Cabinet          @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  trustBankAccount TrustBankAccount @relation(fields: [trustBankAccountId], references: [id], onDelete: Cascade)

  @@unique([userId, trustBankAccountId])
  @@index([cabinetId])
}

/// Transfert de fonds entre cartes-clients.
///
/// s. 18(4) By-Law 9 : « A record showing all transfers of money between clients'
/// trust ledger accounts **and explaining the purpose for which each transfer is
/// made**. » Le règlement suppose donc que ces transferts existent : il en exige le
/// registre. art. 56(3) B-1 r.5 permet le transfert direct vers un autre compte en
/// fidéicommis.
///
/// SAFE les interdisait de façon absolue. Le sur-blocage poussait au contournement
/// par un retrait suivi d'un dépôt, deux opérations qui cassent le lien et rendent ce
/// registre impossible à produire.
model ClientLedgerTransfer {
  id                 String   @id @default(cuid())
  cabinetId          String
  trustBankAccountId String
  date               DateTime
  amount             Float

  fromClientId  String
  fromDossierId String?
  toClientId    String
  toDossierId   String?

  /// s. 18(4) — « explaining the purpose for which each transfer is made ».
  purpose String

  /// Les deux écritures append-only produites par le transfert.
  debitTransactionId  String? @unique
  creditTransactionId String? @unique

  createdById String?
  createdAt   DateTime @default(now())

  cabinet Cabinet @relation(fields: [cabinetId], references: [id], onDelete: Cascade)

  @@index([cabinetId, date])
  @@index([fromClientId])
  @@index([toClientId])
}

/// Registre des frais de renvoi — s. 19.1 By-Law 9.
///
/// « Every licensee who pays or receives a referral fee […] shall maintain […] a
/// record showing all referral fees received / paid » avec, dans chaque cas, la date,
/// le mode, le montant, le titulaire concerné et le client, plus tous les documents
/// afférents.
///
/// ⚠️ ONTARIO SEULEMENT. B-1 r.5 ne traite pas des frais de renvoi.
model ReferralFee {
  id                  String   @id @default(cuid())
  cabinetId           String
  /// RECEIVED | PAID
  direction           String
  date                DateTime
  /// s. 19.1(1)(2) — « the method by which each referral fee is received / paid ».
  method              String
  amount              Float
  /// Titulaire de qui le frais est reçu, ou à qui il est payé.
  counterpartyLicensee String
  clientId            String?
  /// s. 19.1(2) — « the number or a similar identifier of any document used to pay ».
  documentIdentifier  String?
  agreementDocumentId String?
  createdAt           DateTime @default(now())

  cabinet Cabinet @relation(fields: [cabinetId], references: [id], onDelete: Cascade)

  @@index([cabinetId, date])
  @@index([cabinetId, direction])
}

/// Autre bien en fidéicommis — un bien qui n'est pas de l'argent.
///
/// Art. 1(3) B-1 r.5 : « tout bien, autre qu'une somme d'argent, reçu par un avocat
/// pour être affecté suivant les instructions du client ou d'une autre personne ».
/// En pratique : titres, actions, testaments originaux, actes notariés, clés, bijoux
/// détenus en garantie, chèques certifiés non déposés.
///
/// Art. 43 : registre PERMANENT tenu « dès réception ou remise ».
/// s. 18(9) By-Law 9 : même registre, mais avec DEUX champs de plus — la valeur du
/// bien et la personne qui le détenait immédiatement avant.
///
/// Conservation : 7 ans à compter de la fermeture du dossier au Québec (art. 31) ;
/// DIX ans en Ontario, le registre des biens étant le paragraphe 9 de la s. 18, visé
/// par la s. 23(2) et non par les six ans de la s. 23(1).
/// Rapport comptable annuel — art. 42 B-1 r.5.
///
/// « Au moins une fois par an et dans les 30 jours suivant la réception d'une demande
/// par le directeur de l'inspection professionnelle, l'avocat doit transmettre à ce
/// dernier, en utilisant le formulaire prescrit par le Comité exécutif, un rapport
/// comptable annuel couvrant la période de 12 mois identifiée dans la demande. »
///
/// ⚠️ QUÉBEC SEULEMENT. By-Law 9, lu intégralement, n'impose aucun rapport comptable
/// annuel : ses obligations périodiques s'arrêtent à la comparaison mensuelle de la
/// s. 18(8). Le « Lawyer Annual Report » du LSO existe par ailleurs, mais hors de
/// By-Law 9 et hors du corpus vérifié — il n'est pas modélisé ici.
///
/// Deux blocs n'ont PAS d'équivalent au rapport mensuel :
///   42(4) le total des recettes et des débours de CHAQUE MOIS de la période ;
///   42(7) la liste des comptes fermés durant la période — obligation qui explique
///         pourquoi un compte fermé n'est jamais supprimé.
/// Incident de solde débiteur sur une carte-client.
///
/// Art. 60 B-1 r.5 : « L'avocat doit combler SANS DÉLAI tout solde débiteur en
/// fidéicommis dans un dossier, QUELLE QU'EN SOIT LA RAISON. »
/// s. 14 By-Law 9 : « a licensee shall AT ALL TIMES maintain sufficient balances on
/// deposit in his or her trust accounts. »
///
/// Un solde débiteur n'est pas un écart comptable : ce sont les fonds d'un AUTRE
/// client qui servent ce dossier. L'incident est donc consigné comme un événement
/// daté, pas comme un état.
///
/// ⚠️ Aucun des deux textes ne chiffre de délai. `detectedAt` et `resolvedAt`
/// mesurent l'ancienneté, mais aucune colonne ne porte d'échéance : inventer un
/// seuil convertirait « sans délai » en une tolérance que le règlement ne donne pas.
///
/// L'incident RESTE après résolution. Un découvert survenu le 3 et comblé le 4
/// n'apparaîtrait nulle part si l'on ne regardait que les soldes de fin de mois — or
/// c'est ce qu'un inspecteur cherche : non pas l'état à une date, mais ce qui s'est
/// passé.
/// Accès d'inspection : lecture seule, durée limitée, tout journalisé.
///
/// Art. 29 B-1 r.5 : les livres et registres sont accessibles en tout temps au syndic,
/// à ses enquêteurs, au directeur de l'inspection professionnelle et à ses experts,
/// sous réserve de leur confidentialité et de leur sécurité.
///
/// ⚠️ L'INSPECTEUR N'EST PAS UN `User`. Le dépôt compte plus de 330 endroits qui
/// consultent le rôle, et une partie des écritures ne vérifient que l'authentification.
/// Un rôle « lecture seule » ne serait étanche qu'au prix d'un audit exhaustif de ces
/// 330 sites, et le moindre oubli donnerait à un tiers extérieur le droit d'écrire
/// dans la comptabilité d'un cabinet. La session ne crée donc aucun compte, ne porte
/// aucun rôle et n'emprunte aucun chemin d'écriture.
///
/// La durée de 30 jours par défaut ne vient d'aucun texte : c'est un choix, et il est
/// déclaré comme tel dans `lib/compliance/inspection-access.ts`.
/// Cessionnaire désigné en cas de décès ou d'inaptitude.
///
/// Art. 78 B-1 r.5. C'est l'obligation la plus facile à manquer du règlement : elle se
/// tient à froid, souvent des années avant qu'elle ne serve, et rien ne la rappelle.
/// Elle appartient donc au tableau de conformité COURANT, pas à une procédure de fin
/// de vie.
///
/// Art. 75-76 : le jour venu, la cession se fait à un avocat EN EXERCICE, et deux avis
/// écrits distincts sont dus — au syndic ET aux clients.
///
/// ⚠️ QUÉBEC SEULEMENT. Le LSO impose un plan de succession, relevé en recherche web
/// mais jamais lu dans un texte officiel. Le modèle ne prétend pas le couvrir.
model PracticeSuccessionPlan {
  id        String @id @default(cuid())
  cabinetId String @unique

  /// Avocat en exercice à qui les dossiers, livres et registres seront cédés.
  successorName        String
  successorBarreauNo   String?
  successorEmail       String?
  successorPhone       String?
  /// Le cessionnaire a-t-il accepté ? Un cessionnaire qui l'ignore n'en est pas un.
  successorConfirmedAt DateTime?

  /// Révision : l'art. 78 n'impose aucune périodicité. La date sert à montrer que le
  /// plan est vivant, pas à déclarer une échéance que le texte ne pose pas.
  lastReviewedAt DateTime?

  notes     String?
  province  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cabinet Cabinet @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
}

model InspectionAccessSession {
  id        String @id @default(cuid())
  cabinetId String

  /// Qui inspecte. Un accès anonyme donnerait un journal qui ne prouve rien.
  inspectorName         String
  inspectorOrganization String
  /// Pourquoi. Le cabinet reste tenu au secret professionnel.
  purpose               String

  /// Le jeton n'est JAMAIS stocké en clair : seule son empreinte l'est.
  tokenHash String @unique

  /// Période que l'inspecteur peut consulter. Null = aucune borne demandée.
  scopeFrom DateTime?
  scopeTo   DateTime?

  grantedAt      DateTime @default(now())
  grantedByUserId String
  expiresAt      DateTime
  revokedAt      DateTime?
  revokedByUserId String?
  revokedReason   String?

  province  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cabinet Cabinet                     @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  reads   InspectionAccessRead[]

  @@index([cabinetId])
  @@index([cabinetId, expiresAt])
}

/// Une consultation, une ligne.
///
/// Sert le cabinet autant que l'inspecteur : c'est la seule façon de dire plus tard
/// qui a vu quoi, et quand. Append-only par construction — aucune mise à jour, aucune
/// suppression n'est prévue par le service.
model InspectionAccessRead {
  id        String   @id @default(cuid())
  sessionId String
  /// REGISTERS | MONTHLY_REPORTS | SUPPORTING_DOCUMENTS | ...
  resource   String
  resourceId String?
  detail     String?
  readAt     DateTime @default(now())

  session InspectionAccessSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, readAt])
}

model TrustShortfall {
  id                 String   @id @default(cuid())
  cabinetId          String
  trustBankAccountId String?
  clientId           String
  dossierId          String?

  /// Montant à combler, toujours positif.
  amount     Float
  detectedAt DateTime @default(now())
  /// Solde de la carte-client au moment de la détection, pour l'historique.
  balanceAtDetection Float

  resolvedAt        DateTime?
  /// CABINET_OPERATING | CLIENT_DEPOSIT | LEDGER_CORRECTION
  remediationSource String?
  /// Écriture de renflouement, quand elle existe.
  remediationTransactionId String?
  remediationNote          String?
  resolvedById             String?

  province  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cabinet Cabinet @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  client  Client  @relation(fields: [clientId], references: [id], onDelete: Restrict)

  @@index([cabinetId])
  /// Les incidents OUVERTS sont ceux dont resolvedAt est nul : c'est la requête de
  /// l'alerte et du tableau de conformité.
  @@index([cabinetId, resolvedAt])
  @@index([clientId])
}

/// Versement des intérêts d'un compte en fidéicommis.
///
/// Compte général : Fonds d'études juridiques du Barreau au Québec (art. 50,
/// renvoyant à B-1, r. 10) · Law Foundation of Ontario en Ontario (Law Society Act,
/// s. 57). Compte particulier : le client (art. 62).
///
/// ⚠️ INCERTITUDE ASSUMÉE DANS LA FORME DE CE MODÈLE. Ni B-1 r.10 ni la s. 57 n'ont
/// été lus. Le BÉNÉFICIAIRE est certain, il découle des articles lus. La MÉCANIQUE
/// ne l'est pas : taux, fréquence, qui calcule, quel formulaire.
///
/// Ce modèle ne porte donc AUCUN champ de calcul — pas de taux, pas d'échéance. Il
/// consigne un versement constaté : période, montant, date, preuve. Ajouter un taux
/// reviendrait à fabriquer une règle.
model TrustInterestRemittance {
  id                 String   @id @default(cuid())
  cabinetId          String
  trustBankAccountId String

  periode     String // "YYYY-MM"
  /// FONDS_ETUDES_JURIDIQUES | LAW_FOUNDATION_ONTARIO | CLIENT
  beneficiary String
  amount      Float

  remittedAt         DateTime?
  /// Art. 32 QC / s. 18(10) ON : une date sans pièce n'est qu'une affirmation.
  proofDocumentId    String?
  note               String?
  recordedById       String?

  province  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cabinet          Cabinet          @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  trustBankAccount TrustBankAccount @relation(fields: [trustBankAccountId], references: [id], onDelete: Restrict)

  @@unique([trustBankAccountId, periode, beneficiary])
  @@index([cabinetId, periode])
  @@index([cabinetId, remittedAt])
}

model TrustAnnualReport {
  id                 String  @id @default(cuid())
  cabinetId          String
  trustBankAccountId String

  /// La période est identifiée DANS LA DEMANDE : ni l'année civile, ni forcément
  /// l'exercice financier.
  periodStart        String  // "YYYY-MM"
  periodEnd          String  // "YYYY-MM"
  /// Le délai de 30 jours court depuis cette date, pas depuis le calendrier.
  requestReceivedAt  DateTime?

  status             String  @default("draft") // draft | complete | certified

  // ── Art. 42(5) — état comparatif à la fin de la période ───────────────────
  journalBalance          Float
  bankStatementBalance    Float
  ledgerSumBalance        Float
  outstandingChequesTotal Float @default(0)
  depositsInTransitTotal  Float @default(0)
  reconciledBalance       Float
  ecartPeriode            Float @default(0)
  ecartCartesClients      Float @default(0)
  /// « La copie du relevé de l'institution financière pour le DERNIER MOIS de la
  /// période doit être jointe au rapport. » Obligatoire pour certifier.
  bankStatementDocumentId String?

  /// Instantané figé à la certification (PR-5).
  snapshotJson         String?
  verifiedControlsJson String?
  declarationText      String?
  certifiedById        String?
  certifiedAt          DateTime?
  /// Date de transmission effective au directeur de l'inspection professionnelle.
  submittedAt          DateTime?
  submissionDocumentId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cabinet          Cabinet          @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  trustBankAccount TrustBankAccount @relation(fields: [trustBankAccountId], references: [id], onDelete: Restrict)

  monthlyTotals  TrustAnnualMonthlyTotal[]
  closedAccounts TrustAnnualClosedAccount[]
  ledgerSnapshot     TrustClientLedgerSnapshot[]
  outstandingCheques TrustOutstandingChequeLine[]
  depositsInTransit  TrustDepositInTransitLine[]

  @@unique([trustBankAccountId, periodStart])
  @@index([cabinetId, periodStart])
  @@index([cabinetId, status])
}

/// Art. 42(4) — « le total des recettes et des débours au cours de CHAQUE MOIS de la
/// période ». Douze lignes, là où l'art. 41(4) n'en demande qu'une.
model TrustAnnualMonthlyTotal {
  id                 String @id @default(cuid())
  annualReportId     String
  periode            String // "YYYY-MM"
  totalReceipts      Float  @default(0)
  totalDisbursements Float  @default(0)
  /// Le rapport mensuel de ce mois est-il certifié ? Conditionne la certification
  /// annuelle (art. 40 combiné à l'art. 42).
  monthlyReportCertified Boolean @default(false)

  annualReport TrustAnnualReport @relation(fields: [annualReportId], references: [id], onDelete: Cascade)

  @@unique([annualReportId, periode])
  @@index([annualReportId])
}

/// Art. 42(7) — « la liste de chacun des comptes généraux et particuliers en
/// fidéicommis qui ont été fermés au cours de la période ».
///
/// C'est cette obligation qui explique qu'un compte fermé ne soit jamais supprimé :
/// il doit pouvoir figurer au rapport annuel de la période de sa fermeture.
model TrustAnnualClosedAccount {
  id                 String   @id @default(cuid())
  annualReportId     String
  trustBankAccountId String
  accountType        String   // GENERAL | PARTICULIER
  accountLabel       String
  institutionName    String
  accountNumberLast4 String
  clientName         String?
  closedAt           DateTime
  closureReason      String?

  annualReport TrustAnnualReport @relation(fields: [annualReportId], references: [id], onDelete: Cascade)

  @@index([annualReportId])
}

model TrustProperty {
  id                   String   @id @default(cuid())
  cabinetId            String
  clientId             String
  dossierId            String?

  /// Art. 43 / s. 18(9) — description du bien.
  description          String
  /// « s'il y a lieu » : le texte le conditionne. Un bien peut n'en porter aucun.
  identificationNumber String?
  /// s. 18(9) ON seulement. B-1 r.5 ne l'exige pas.
  estimatedValue       Float?

  /// s. 18(9) ON seulement — « the person who had possession immediately before ».
  receivedFromName     String?
  receivedAt           DateTime

  /// Art. 45 QC — lieu de garde, et tout changement doit être communiqué au client.
  /// L'historique est conservé : un lieu écrasé fait perdre la trace du déplacement.
  storageLocation      String?
  storageHistoryJson   String?
  storageNotifiedAt    DateTime?

  /// Art. 44 QC — le bien vient d'un tiers : le client doit en être informé sans délai.
  fromThirdParty       Boolean   @default(false)
  clientNotifiedAt     DateTime?

  /// Art. 46 QC — « un autre bien en fidéicommis doit être utilisé selon son
  /// affectation ». Sans affectation consignée, l'obligation est invérifiable.
  purpose              String?

  /// Art. 43 / s. 18(9) — remise du bien.
  releasedAt           DateTime?
  releasedToName       String?
  releaseSignatureDocumentId String?

  /// Province du régime appliqué : les champs exigés ne sont pas les mêmes.
  province             String
  createdById          String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  cabinet Cabinet @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  client  Client  @relation(fields: [clientId], references: [id], onDelete: Restrict)

  @@index([cabinetId])
  @@index([cabinetId, releasedAt])
  @@index([clientId])
  @@index([dossierId])
}

model CashReceipt {
  id            String   @id @default(cuid())
  cabinetId     String
  /// Numérotation séquentielle sans trou, par cabinet. Le carnet de reçus « en
  /// double » de la s. 19(1) suppose une séquence vérifiable.
  receiptNumber Int
  date          DateTime

  /// Art. 70(2) / s. 19(1) — nom de la personne de qui la somme provient.
  payerName     String
  /// Montant tel que présenté, dans sa devise d'origine.
  amount        Float
  currency      String   @default("CAD")
  /// Art. 73 / s. 4(2) — valeur en dollars canadiens. C'est ce montant qui est
  /// agrégé et comparé au seuil.
  cadAmount     Float
  conversionRate     Float?
  conversionRateDate DateTime?

  clientId      String
  dossierId     String
  /// Art. 70(6) — objet pour lequel la somme est reçue. Non exigé en Ontario.
  purpose       String?

  receivedByUserId String
  /// Art. 70 al. 2 — les DEUX signatures.
  licenseeSignatureDocumentId String?
  payerSignatureDocumentId    String?
  /// s. 19(2) By-Law 9 — la signature du payeur peut manquer après efforts
  /// raisonnables, à condition de les documenter. Aucune dispense équivalente au
  /// Québec : le champ y reste vide.
  payerSignatureWaivedReason  String?

  /// Province du régime appliqué. Une réception jugée conforme sous un régime ne
  /// prouve pas la conformité sous l'autre : les exceptions ne sont pas les mêmes.
  province      String
  /// La somme est-elle reçue en fidéicommis ? Décisif au Québec (art. 69).
  intoTrust     Boolean  @default(true)
  /// Exception invoquée au seuil, le cas échéant (art. 69 QC / s. 6 ON).
  exemptionInvoked      String?
  exemptionJustification String?
  /// s. 6(e) ON — l'exception « honoraires, débours, cautionnement » n'est acquise
  /// que si tout remboursement se fait lui aussi en espèces. Mémorisé à la réception.
  refundMustBeCash      Boolean @default(false)

  /// Art. 71 QC — déclaration au directeur de l'inspection dans les 30 jours.
  /// Sans équivalent ontarien : les champs y restent nuls.
  declarationDueAt      DateTime?
  declarationSentAt     DateTime?
  declarationDocumentId String?

  trustTransactionId String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  cabinet Cabinet @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  client  Client  @relation(fields: [clientId], references: [id], onDelete: Restrict)
  refunds CashRefund[]

  @@unique([cabinetId, receiptNumber])
  @@index([cabinetId, date])
  @@index([cabinetId, dossierId])
  @@index([cabinetId, declarationDueAt])
}

/// Remboursement d'une somme reçue en espèces.
///
/// Art. 72 B-1 r.5 : « Malgré l'article 57, l'avocat qui est tenu de rembourser, en
/// tout ou en partie, une somme de 7 500 $ ou plus qu'il a reçue en espèces, doit
/// effectuer ce remboursement EN ESPÈCES », contre un reçu signé par le bénéficiaire
/// portant cinq mentions.
///
/// C'est le SEUL cas où le règlement impose une sortie en espèces, alors que
/// l'art. 57 l'interdit par ailleurs. Le flux est donc distinct et explicite.
model CashRefund {
  id            String   @id @default(cuid())
  cabinetId     String
  cashReceiptId String
  date          DateTime
  amount        Float
  /// Art. 72(2) — nom de la personne qui reçoit la somme.
  recipientName String
  clientId      String
  dossierId     String
  /// Reçu signé par le bénéficiaire.
  signatureDocumentId String?
  createdAt     DateTime @default(now())

  cabinet     Cabinet     @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  cashReceipt CashReceipt @relation(fields: [cashReceiptId], references: [id], onDelete: Restrict)

  @@index([cabinetId])
  @@index([cashReceiptId])
}

model TrustMonthlyReport {
  id                 String  @id @default(cuid())
  cabinetId          String
  trustBankAccountId String
  periode            String  // "YYYY-MM"

  /// draft | complete | certified
  status             String  @default("draft")

  // ── Art. 41(4) — total des recettes et des débours du mois ────────────────
  totalReceipts      Float   @default(0)
  totalDisbursements Float   @default(0)

  // ── Art. 41(5) — état comparatif journal ↔ relevé bancaire ────────────────
  bankStatementBalance    Float
  journalBalance          Float
  /// 3ᵉ voie : somme des soldes inscrits aux cartes-clients (art. 41(1)).
  ledgerSumBalance        Float
  outstandingChequesTotal Float @default(0)
  depositsInTransitTotal  Float @default(0)
  reconciledBalance       Float
  /// reconciledBalance − journalBalance
  ecartBanque             Float @default(0)
  /// ledgerSumBalance − journalBalance
  ecartCartesClients      Float @default(0)

  /// Art. 41(7) — « la copie du relevé de l'institution financière pour le mois
  /// visé ». Obligatoire pour certifier : un rapport sans relevé ne compare rien.
  bankStatementDocumentId String?

  /// Instantané immuable figé à la certification (PR-5). Un recalcul ultérieur ne
  /// réécrit JAMAIS un rapport signé : un inspecteur compare des documents datés.
  snapshotJson       String?

  /// PR-3 — liste des contrôles RÉELLEMENT exécutés, d'où l'attestation est tirée.
  verifiedControlsJson String?
  declarationText      String?
  certifiedById        String?
  certifiedAt          DateTime?
  lockedAt             DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cabinet          Cabinet          @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  trustBankAccount TrustBankAccount @relation(fields: [trustBankAccountId], references: [id], onDelete: Restrict)

  ledgerSnapshot    TrustClientLedgerSnapshot[]
  outstandingCheques TrustOutstandingChequeLine[]
  depositsInTransit  TrustDepositInTransitLine[]
  discrepancies      TrustDiscrepancyReason[]

  @@unique([trustBankAccountId, periode])
  @@index([cabinetId, periode])
  @@index([cabinetId, status])
}

/// Art. 41(1) — « la liste des soldes inscrits aux cartes-clients à la fin du mois,
/// en indiquant le nom du client, le numéro ou la désignation du dossier et LA DATE
/// DE LA DERNIÈRE INSCRIPTION ».
/// s. 18(8)i — « A detailed listing made monthly showing the amount of money held in
/// trust for each client and identifying each client. »
///
/// `lastEntryDate` est le champ que SAFE n'avait nulle part. Sans lui, ce bloc du
/// rapport est incomplet quoi qu'on fasse.
model TrustClientLedgerSnapshot {
  id            String    @id @default(cuid())
  /// Rattachement au rapport MENSUEL (art. 41) ou ANNUEL (art. 42). Les deux
  /// rapports exigent les mêmes listes : les dupliquer ferait diverger deux
  /// définitions d'une même chose.
  reportId      String?
  clientId      String
  clientName    String
  dossierId     String?
  dossierRef    String?
  balance       Float
  lastEntryDate DateTime?

  report       TrustMonthlyReport? @relation(fields: [reportId], references: [id], onDelete: Cascade)
  annualReportId String?
  annualReport   TrustAnnualReport?  @relation(fields: [annualReportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@index([annualReportId])
}

/// Art. 41(2) — « la liste des chèques en circulation à la fin du mois, en indiquant
/// pour chacun le montant, la date d'émission, le numéro du chèque, le nom du client
/// et le numéro ou la désignation du dossier ».
model TrustOutstandingChequeLine {
  id           String   @id @default(cuid())
  reportId     String?
  chequeId     String?
  chequeNumber Int
  issueDate    DateTime
  amount       Float
  payeeName    String
  clientName   String?
  dossierRef   String?
  /// Signalé quand le chèque circule depuis plus de six mois. Repère de pratique
  /// bancaire, PAS une règle du Barreau.
  stale        Boolean  @default(false)

  report       TrustMonthlyReport? @relation(fields: [reportId], references: [id], onDelete: Cascade)
  annualReportId String?
  annualReport   TrustAnnualReport?  @relation(fields: [annualReportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@index([annualReportId])
}

/// Art. 41(3) — « la liste des recettes en circulation à la fin du mois, en indiquant
/// pour chacune le montant, la date de réception, le nom du client et le numéro ou la
/// désignation du dossier ».
model TrustDepositInTransitLine {
  id             String   @id @default(cuid())
  reportId       String?
  transactionId  String?
  receivedDate   DateTime
  amount         Float
  payerName      String?
  clientName     String?
  dossierRef     String?

  report       TrustMonthlyReport? @relation(fields: [reportId], references: [id], onDelete: Cascade)
  annualReportId String?
  annualReport   TrustAnnualReport?  @relation(fields: [annualReportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@index([annualReportId])
}

/// s. 18(8) By-Law 9 — « together with THE REASONS for any differences between the
/// totals ». Le motif est une donnée structurée, pas une note libre : un écart sans
/// motif consigné est exactement ce qu'un inspecteur relève.
model TrustDiscrepancyReason {
  id           String    @id @default(cuid())
  reportId     String
  /// BANK | LEDGER — quelle comparaison présente l'écart.
  kind         String
  amount       Float
  explanation  String
  raisedAt     DateTime  @default(now())
  resolvedAt   DateTime?
  resolvedById String?

  report TrustMonthlyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
}

model TrustCheque {
  id                 String            @id @default(cuid())
  cabinetId          String
  trustBankAccountId String
  /// Numérotation consécutive, unique par compte (art. 61).
  chequeNumber       Int
  issueDate          DateTime
  /// Bénéficiaire nominatif. VALIDÉ : jamais vide, jamais « cash », « caisse »,
  /// « bearer » ou « porteur » (art. 57 al. 2 QC / s. 11(a) ON).
  payeeName          String
  amount             Float
  clientId           String?
  dossierId          String?
  trustTransactionId String?           @unique
  status             TrustChequeStatus @default(ISSUED)
  clearedAt          DateTime?
  voidedAt           DateTime?
  /// Un chèque annulé est conservé, jamais supprimé : un trou dans la séquence est
  /// exactement ce qu'un inspecteur cherche.
  voidReason         String?
  /// Signataire. Art. 11(b) By-Law 9 : un non-titulaire ne peut signer que s'il a le
  /// pouvoir de signature ET est cautionné. Contrôle posé au chantier CH-07.
  signedById         String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  cabinet          Cabinet          @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  trustBankAccount TrustBankAccount @relation(fields: [trustBankAccountId], references: [id], onDelete: Restrict)

  @@unique([trustBankAccountId, chequeNumber])
  @@index([cabinetId])
  @@index([cabinetId, status])
  @@index([trustBankAccountId, issueDate])
}

enum TrustChequeStatus {
  /// Émis, non encore compensé. C'est l'état qui alimente la liste de l'art. 41(2).
  ISSUED
  /// Compensé par la banque.
  CLEARED
  /// Annulé. Conservé pour ne pas créer de trou dans la séquence.
  VOIDED
  /// En circulation depuis plus de six mois. Signalé : fonds possiblement non réclamés.
  STALE
}

/// Pièce justificative rattachée à une opération en fidéicommis.
///
/// Art. 32 B-1 r.5 : conservation 7 ans après la fin de l'exercice de « toutes les
/// pièces justificatives ou de contrôle », nommément les copies de reçus émis, les
/// relevés d'institutions financières, les copies de chèques compensés, les
/// bordereaux de dépôt détaillés et les documents confirmant les virements
/// électroniques — plus « une copie de tout chèque ou autre ordre de paiement reçu
/// en fidéicommis ».
/// s. 18(10) By-Law 9 : « Bank statements or pass books, cashed cheques and detailed
/// duplicate deposit slips for all trust and general accounts. »
model TrustTransactionDocument {
  id                 String                      @id @default(cuid())
  trustTransactionId String
  documentId         String
  role               TrustSupportingDocumentRole
  createdAt          DateTime                    @default(now())

  trustTransaction TrustTransaction @relation(fields: [trustTransactionId], references: [id], onDelete: Cascade)
  document         Document         @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@unique([trustTransactionId, documentId, role])
  @@index([trustTransactionId])
  @@index([documentId])
}

enum TrustSupportingDocumentRole {
  /// Art. 32(2) — copie de tout chèque ou ordre de paiement REÇU en fidéicommis.
  CHEQUE_RECU
  /// Art. 32(3) — bordereau de dépôt détaillé.
  BORDEREAU_DEPOT
  /// Art. 32(3) / s. 18(10) — chèque compensé.
  CHEQUE_COMPENSE
  /// Art. 32(3) — document confirmant une opération par virement électronique.
  CONFIRMATION_VIREMENT
  /// Art. 70 — reçu d'espèces signé par les deux parties.
  RECU_ESPECES
  /// Art. 41(7) / s. 18(10) — relevé de l'institution financière.
  RELEVE_BANCAIRE
  AUTRE
}

model TrustBankAccount {
  id                 String               @id @default(cuid())
  cabinetId          String
  type               TrustBankAccountType @default(GENERAL)

  /// Libellé légal du compte tel qu'il apparaît à l'institution.
  /// VALIDÉ : doit contenir « en fidéicommis » ou « in trust » (art. 50 al. 2 et 63 al. 2 QC).
  accountLabel       String
  institutionName    String
  institutionBranch  String?
  /// Adresse de la succursale. Art. 50 QC : succursale QUÉBÉCOISE obligatoire.
  branchAddress      String?
  branchProvince     String?
  /// Numéro de compte. Exigé par l'art. 41(6) et 42(6) pour les rapports
  /// réglementaires, donc il ne peut pas être omis.
  /// ⚠️ Stocké en clair : aucune couche de chiffrement applicative n'existe encore
  /// dans le dépôt. Chantier de chiffrement de champ ouvert séparément.
  accountNumber      String
  /// Quatre derniers chiffres, pour l'affichage courant sans exposer le numéro complet.
  accountNumberLast4 String
  currency           String               @default("CAD")

  /// Art. 50 QC : l'institution doit avoir conclu une entente avec le Barreau au
  /// sens du Règlement sur le fonds d'études juridiques (B-1, r. 10).
  barreauAgreementConfirmed Boolean        @default(false)
  /// Art. 51 QC (compte général) et 64 QC (compte particulier) : formulaire prescrit
  /// transmis sans délai au Barreau ET à l'institution, l'avocat en conserve copie.
  regulatorNotifiedAt       DateTime?
  regulatorFormDocumentId   String?
  /// Art. 64 QC : pour un compte particulier, un exemplaire est aussi remis au client.
  clientCopySentAt          DateTime?

  openedAt           DateTime
  /// Art. 42(7) QC : la liste des comptes fermés durant la période est exigée au
  /// rapport annuel. Un compte fermé n'est donc jamais supprimé.
  closedAt           DateTime?
  closureReason      String?

  /// Comptes particuliers seulement (art. 62 à 68 QC) : ouverts quand le client
  /// exige que les revenus de son dépôt lui soient remis.
  clientId           String?
  dossierId          String?
  initialDeposit     Float?

  /// Bénéficiaire des intérêts. Compte général : Fonds d'études juridiques (QC,
  /// art. 50 renvoyant à B-1 r.10) ou Law Foundation of Ontario (s. 57 Law Society
  /// Act). Compte particulier : le client (art. 62).
  interestBeneficiary TrustInterestBeneficiary @default(FONDS_ETUDES_JURIDIQUES)

  /// Solde de contrôle, dérivé du registre append-only. Cache, jamais autorité (PR-1).
  currentBalance     Float                @default(0)

  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  cabinet         Cabinet               @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  client          Client?               @relation(fields: [clientId], references: [id], onDelete: Restrict)
  transactions    TrustTransaction[]
  reconciliations TrustReconciliation[]
  cheques         TrustCheque[]
  monthlyReports  TrustMonthlyReport[]
  annualReports   TrustAnnualReport[]
  interestRemittances  TrustInterestRemittance[]
  transferRequisitions ElectronicTrustTransferRequisition[]
  signatories          TrustSignatory[]

  @@index([cabinetId])
  @@index([cabinetId, type])
  @@index([cabinetId, closedAt])
}

enum TrustBankAccountType {
  /// Compte général en fidéicommis (art. 50 QC / s. 7 ON). Fonds de plusieurs clients.
  GENERAL
  /// Compte particulier en fidéicommis (art. 62 QC). Un seul client, revenus à lui remettre.
  PARTICULIER
}

enum TrustInterestBeneficiary {
  FONDS_ETUDES_JURIDIQUES
  LAW_FOUNDATION_ONTARIO
  CLIENT
}

model TrustAccount {
  id             String   @id @default(cuid())
  cabinetId      String
  clientId       String
  matterId       String?
  currentBalance Float    @default(0)
  currency       String   @default("CAD")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  cabinet      Cabinet            @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  client       Client             @relation(fields: [clientId], references: [id], onDelete: Restrict)
  matter       Dossier?           @relation(fields: [matterId], references: [id], onDelete: SetNull)
  transactions TrustTransaction[]

  @@unique([cabinetId, clientId, matterId])
  @@index([cabinetId])
  @@index([clientId])
  @@index([matterId])
}

model TrustTransaction {
  id              String                       @id @default(cuid())
  cabinetId       String
  trustAccountId  String?
  /// Compte bancaire en fidéicommis d'où sortent ou où entrent les fonds.
  /// Nullable le temps de la reprise ; obligatoire pour toute nouvelle écriture.
  trustBankAccountId String?
  clientId        String
  dossierId       String?
  date            DateTime
  amount          Float
  type            TrustTransactionType
  transactionType TrustTransactionTypeBilling?
  balanceAfter    Float?
  invoiceId       String?
  note            String?
  description     String?
  reference       String?
  modePaiement    TrustModePaiement?
  /// Motif réglementaire du retrait (art. 56 QC / s. 9(1) ON). Obligatoire sur tout
  /// nouveau retrait ; nullable pour l'historique antérieur à CH-00.
  withdrawalMotive TrustWithdrawalMotive?

  // ── CH-02 — champs du journal de caisse en fidéicommis ─────────────────────
  // Art. 38 B-1 r.5 et s. 18(1)(2) By-Law 9 énumèrent ce que CHAQUE ligne doit
  // porter. Sans ces champs, le journal de caisse et les cartes-clients (art. 39)
  // sont inexploitables, et le rapport mensuel de l'art. 41 ne peut pas être rempli.

  /// Art. 38(1)c QC / s. 18(1) ON — « le nom de la personne de qui la somme est reçue ».
  /// Distinct du client : un tiers peut verser pour lui (art. 49).
  payerName        String?
  /// Art. 38(2)c QC / s. 18(2) ON — « le nom du bénéficiaire du débours ».
  payeeName        String?
  /// Art. 38(1)f et (2)f QC — « l'objet pour lequel la somme est reçue / le débours
  /// est effectué ». Code normalisé pour les rapports, texte libre pour le détail.
  purposeCode      TrustPurposeCode?
  purposeText      String?
  /// Art. 38(2)h QC / s. 18(2) ON — « le numéro de chèque » ou tout identifiant du
  /// document ayant servi au débours.
  chequeNumber     Int?
  /// Art. 38(1)g QC — « une indication selon laquelle la somme a été reçue en
  /// espèces ». Normalisé, plutôt que déduit du mode de paiement.
  isCash           Boolean @default(false)
  /// Art. 50 QC (« sans délai ») / s. 7(1) ON (« immediately »). Sans les DEUX dates,
  /// le respect du délai de dépôt est invérifiable : c'est l'écart entre elles qui
  /// constitue la preuve.
  receivedAt       DateTime?
  depositedAt      DateTime?
  /// Art. 48 QC — « les sommes d'argent en fidéicommis doivent être utilisées selon
  /// leur affectation ». Sans affectation consignée, l'obligation est invérifiable.
  fundAllocation   String?
  /// Art. 49 QC — l'avocat informe le client sans délai quand les fonds viennent
  /// d'un tiers. La date de notification est la preuve du « sans délai ».
  fromThirdParty   Boolean @default(false)
  clientNotifiedAt DateTime?
  correctionOfId  String?
  createdById     String?
  createdAt       DateTime                     @default(now())

  cabinet      Cabinet            @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  trustAccount TrustAccount?      @relation(fields: [trustAccountId], references: [id], onDelete: SetNull)
  trustBankAccount TrustBankAccount? @relation(fields: [trustBankAccountId], references: [id], onDelete: Restrict)
  client       Client             @relation(fields: [clientId], references: [id], onDelete: Restrict)
  dossier      Dossier?           @relation(fields: [dossierId], references: [id], onDelete: SetNull)
  invoice      Invoice?           @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  correctionOf TrustTransaction?  @relation("TrustCorrection", fields: [correctionOfId], references: [id], onDelete: SetNull)
  corrections  TrustTransaction[] @relation("TrustCorrection")
  supportingDocuments TrustTransactionDocument[]

  @@index([cabinetId])
  @@index([trustAccountId])
  @@index([clientId])
  @@index([dossierId])
  @@index([date])
  @@index([cabinetId, clientId, dossierId, date])
  @@index([trustBankAccountId])
  @@index([cabinetId, trustBankAccountId, date])
}

