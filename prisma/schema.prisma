/// Motif réglementaire d'un retrait du compte général en fidéicommis.
/// Source : B-1 r.5 art. 56 (QC) — trois seuls retraits permis ;
///          By-Law 9 s. 9(1) (ON) — cinq motifs, dont le dépôt par inadvertance.
/// Un retrait sans motif est refusé (CH-00, programme Inspection Ready).
/// Objet d'un mouvement en fidéicommis (art. 38(1)f et (2)f B-1 r.5).
/// Code normalisé pour les rapports réglementaires ; `purposeText` porte le détail.
enum TrustPurposeCode {
  AVANCE_HONORAIRES
  AVANCE_DEBOURS
  FONDS_CLOTURE
  CONSIGNATION
  REGLEMENT
  SUCCESSION
  REMISE_CLIENT
  PAIEMENT_TIERS
  AUTRE
}

enum TrustWithdrawalMotive {
  /// art. 56(1) QC / s. 9(1)1-2 ON — argent à remettre au client ou à un tiers en son nom.
  REMISE_CLIENT_OU_TIERS
  /// art. 56(2) QC / s. 9(1)3 ON — honoraires et débours POUR LESQUELS LA FACTURATION A ÉTÉ ENVOYÉE.
  HONORAIRES_DEBOURS_FACTURES
  /// art. 56(3) QC / s. 9(1)4 ON — transfert direct vers un autre compte en fidéicommis.
  TRANSFERT_AUTRE_FIDEICOMMIS
  /// s. 9(1)5 ON — sommes déposées par inadvertance qui n'auraient pas dû l'être.
  DEPOT_PAR_INADVERTANCE
}

enum TrustModePaiement {
  CHEQUE
  VIREMENT
  INTERAC
  ESPECES
  AUTRE
}

