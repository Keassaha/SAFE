// Personnes rattachées à un dossier (au-delà du client principal Dossier.clientId).
// Deux natures, jamais confondues :
//  - co_client      : lien vers une fiche Client (facturable, fiducie). clientId requis.
//  - partie_externe : nom libre (adverse/tiers), JAMAIS une fiche Client. nomAffiche requis.
// Garde-fou de conformité : une partie adverse ne devient jamais un Client
// (conflit d'intérêts + Loi 25). Invariants détaillés dans la spec §3.3.
model DossierPartie {
  id        String              @id @default(cuid())
  cabinetId String
  dossierId String
  nature    DossierPartieNature
  role      DossierPartieRole

