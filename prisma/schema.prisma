// --- Module A: Vérification d'identité, documents, audit, consentement ---

enum IdentityVerificationStatus {
  en_attente
  verifie
  refuse
}

model ClientIdentityVerification {
  id         String                     @id @default(cuid())
  clientId   String
  date       DateTime
  methode    String // pièce d'identité, vidéo, etc. (champ libre historique)
  statut     IdentityVerificationStatus @default(en_attente)
  documentId String? // référence optionnelle vers Document (preuve)
  notes      String?
  createdAt  DateTime                   @default(now())
  updatedAt  DateTime                   @updatedAt

  // ── CH-06 — identification et vérification (B-1 r.5 art. 20-27 / By-Law 7.1 Partie III)
  /// Province du régime appliqué au moment de la vérification. Une vérification
  /// faite sous le régime ontarien ne prouve pas la conformité québécoise, et
  /// inversement : la méthode acceptée n'est pas la même.
  province          String?
  /// Code de méthode normalisé, validé contre la liste de la province
  /// (lib/compliance/identity.ts). Le champ `methode` reste libre pour l'historique.
  methodCode        String?
  /// Personne physique ou organisation : les délais et les méthodes en dépendent.
  subjectKind       String?
  /// Source des fonds. ONTARIO SEULEMENT (By-Law 7.1 s. 23(2)). B-1 r.5 ne comporte
  /// aucune obligation équivalente : ne jamais l'exiger d'un cabinet québécois.
  sourceOfFunds     String?
  /// Date à laquelle les renseignements ont été OBTENUS, distincte de la date de
  /// vérification. By-Law 7.1 s. 23(12.1) l'exige explicitement.
  recordedAt        DateTime?
  /// By-Law 7.1 s. 23(12.2) : pour une organisation, mesures prises pour confirmer
  /// l'exactitude des renseignements de propriété effective, et leur date.
  accuracyMeasures  String?
  accuracyConfirmedAt DateTime?
  /// By-Law 7.1 s. 23(2.2) : procédure de repli quand la propriété effective ne peut
  /// pas être établie. Sans équivalent au Québec, où l'obligation est inconditionnelle.
  fallbackSeniorOfficer String?
  fallbackConsistencyNote String?
  fallbackRiskAssessment  String?
  fallbackRecordedAt      DateTime?
  verifiedById      String?

  // ── CH-06.7 — mode de preuve ────────────────────────────────────────────────
  /// Comment la pièce est-elle probante ?
  ///  DOCUMENT_JOINT       : la copie est déposée dans SAFE.
  ///  ATTESTATION_MANUELLE : la copie est conservée ailleurs (papier, coffre,
  ///                         GED externe) et l'avocat l'atteste en indiquant où.
  ///                         L'art. 22 B-1 r.5 exige que la copie soit « consignée
  ///                         ou conservée au dossier », pas qu'elle soit dans SAFE.
  ///  DISPENSE_CABINET     : enregistrée sans pièce sous la dispense du cabinet.
  proofMode             String?
  /// Où la pièce est physiquement conservée. Obligatoire pour ATTESTATION_MANUELLE :
  /// une attestation qui ne dit pas où chercher ne vaut rien à l'inspection.
  proofLocation         String?
  /// Texte de l'attestation, figé au moment de la signature.
  attestationStatement  String?
  attestedById          String?
  attestedAt            DateTime?

  client   Client    @relation(fields: [clientId], references: [id], onDelete: Restrict)
  document Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([clientId])
}

/// Propriété effective d'une organisation cliente.
/// Sources : B-1 r.5 art. 14(2)e et 23(2) (QC) · By-Law 7.1 s. 23(1)7 et 23(2.1) (ON).
///
/// Divergence encodée dans `role` : le Québec exige le nom ET L'OCCUPATION des
/// administrateurs (art. 23(2)1) ; l'Ontario n'exige que leur nom (s. 23(2.1)(a)).
/// Le seuil de 25 % est identique dans les deux régimes, mais l'Ontario le qualifie
/// d'« efforts raisonnables » et prévoit un repli, pas le Québec.
model BeneficialOwner {
  id               String   @id @default(cuid())
  cabinetId        String
  clientId         String
  role             BeneficialOwnerRole
  nom              String
  adresse          String?
  /// Exigée au Québec pour les administrateurs (art. 23(2)1) ; facultative en Ontario.
  occupation       String?
  /// Poste occupé — exigé pour les personnes autorisées (art. 14(2)e / s. 23(1)7).
  poste            String?
  telephone        String?
  /// Pourcentage détenu, directement ou indirectement. Pertinent dès 25 %.
  ownershipPercent Float?
  verifiedAt       DateTime?
  sourceDocumentId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  cabinet Cabinet @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  client  Client  @relation(fields: [clientId], references: [id], onDelete: Restrict)

  @@index([cabinetId])
  @@index([clientId])
  @@index([clientId, role])
}

enum BeneficialOwnerRole {
  /// Administrateur de la société ou de l'organisme.
  ADMINISTRATEUR
  /// Détient, directement ou indirectement, 25 % ou plus.
  DETENTEUR_25_PLUS
  /// Personne autorisée à donner des directives (art. 14(2)e QC / s. 23(1)7 ON).
  PERSONNE_AUTORISEE
  /// Fiduciaire, bénéficiaire connu ou constituant. ONTARIO seulement (s. 23(2.1)(b)(ii)).
  FIDUCIE_PARTIE
}

/// Attestation de répondant — B-1 r.5 art. 24(2). QUÉBEC SEULEMENT.
///
/// Quand l'avocat ne rencontre pas une personne physique présente au Canada, il peut
/// obtenir l'attestation écrite d'un répondant (juge, commissaire à l'assermentation,
/// professionnel au sens du Code des professions). L'Ontario n'a pas ce mécanisme :
/// By-Law 7.1 s. 23(7) énumère limitativement trois méthodes, dont aucune n'est le
/// répondant. Ne jamais proposer ce flux à un cabinet ontarien.
model IdentityAttestation {
  id                    String   @id @default(cuid())
  cabinetId             String
  clientId              String
  /// Nom du répondant.
  attestorName          String
  /// Qualité : juge, commissaire à l'assermentation, professionnel, etc. (art. 24 al. 3).
  attestorQuality       String
  attestorAddress       String
  /// Type et numéro de référence du document d'identification fourni (art. 24 al. 2).
  documentType          String
  documentReference     String
  signedAt              DateTime
  attestationDocumentId String?
  createdAt             DateTime @default(now())

  cabinet Cabinet @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  client  Client  @relation(fields: [clientId], references: [id], onDelete: Restrict)

  @@index([cabinetId])
  @@index([clientId])
}

model Document {
  id                        String    @id @default(cuid())
  cabinetId                 String
  clientId                  String?
  dossierId                 String?
  documentType              String? // depot_tribunal, contrat, correspondance, preuve, etc.
  nom                       String
  mimeType                  String
  sizeBytes                 Int
  storageKey                String // chemin ou clé objet (fichier local ou S3)
  hash                      String? // intégrité
  uploadedById              String
  retentionJusqua           DateTime?

  /// Art. 19 B-1 r.5 — original APPARTENANT AU CLIENT.
  ///
  /// « L'avocat ne peut détruire un document original appartenant au client sans son
  /// autorisation, ou sans lui avoir donné la possibilité de le reprendre. »
  ///
  /// Deux portes de sortie, pas une : l'autorisation OU l'offre de reprise. N'admettre
  /// que l'autorisation bloquerait un cabinet dont le client ne répond plus, et le
  /// pousserait à détruire sans rien consigner.
  ///
  /// ⚠️ Aucune colonne de délai après l'offre : l'art. 19 n'en fixe pas. La date de
  /// l'offre est conservée pour que l'avocat puisse justifier son jugement, pas pour
  /// qu'un compteur décide à sa place.
  isClientOriginal          Boolean   @default(false)
  clientAuthorizedDestroyAt DateTime?
  returnOfferedAt           DateTime?
  originalNote              String?

  sectionKey                String? // section de cartable suggérée/confirmée
  classificationSubtype     String?
  classificationConfidence  Int?
  classificationNeedsReview Boolean   @default(false)
  classificationReason      String?
  // Générateur droit familial : type template (taxonomie), assistance IA, révision humaine
  templateCode              String? // code taxonomie (ex. demande_divorce_contestee, formulaire_annexe_i)
  aiAssisted                Boolean?  @default(false)
  reviewedAt                DateTime?
  reviewedById              String?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  cabinet               Cabinet                      @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  client                Client?                      @relation(fields: [clientId], references: [id], onDelete: Restrict)
  // Rétention Barreau (B-1 r.5, 10 ans) : une pièce ne doit JAMAIS disparaître par
  // effet de bord. Restrict force à traiter le dossier / l'utilisateur d'abord, et
  // empêche la cascade de contourner le garde-fou `DocumentRetentionError`
  // (lib/services/document.ts) et d'orpheliner l'objet Vercel Blob.
  dossier               Dossier?                     @relation(fields: [dossierId], references: [id], onDelete: Restrict)
  uploadedBy            User                         @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  reviewedBy            User?                        @relation("DocumentReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  identityVerifications ClientIdentityVerification[]
  docketEntries         DossierDocketEntry[]
  trustSupportingFor    TrustTransactionDocument[]

  @@index([cabinetId])
  @@index([clientId])
  @@index([dossierId])
  @@index([cabinetId, dossierId])
  @@index([cabinetId, dossierId, sectionKey])
  @@index([templateCode])
}

model AuditLog {
  id          String    @id @default(cuid())
  cabinetId   String
  userId      String?
  entityType  String
  entityId    String
  action      String
  metadata    String? // JSON (legacy)
  oldValues   String? // JSON
