// --- Models CRM ---

// Workspace : singleton SAFE Inc. en v1, multi-tenant préparé pour v2 (ADR-002)
model Workspace {
  id  String @id @default(cuid())
  nom String @default("SAFE Inc.")

  // Mode global (garde-fou phase préchauffage — ADR-005)
  workMode       WorkMode  @default(PRECHAUFFAGE)
  phaseDateDebut DateTime
  phaseDateFin   DateTime?

  // Objectifs phase préchauffage
  cibleTemoignageChiffre       Boolean @default(false)
  cibleCaseStudyPublie         Boolean @default(false)
  cibleAudienceLinkedIn        Int?    @default(1000)
  cibleConversationsQualifiees Int?    @default(20)

  // Métriques actuelles (mises à jour par jobs)
  audienceActuelle       Int @default(0)
  conversationsActuelles Int @default(0)

  leads         Lead[]
  campaigns     Campaign[]
  contentPieces ContentPiece[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Lead : cabinet prospect SAFE (distinct de Cabinet client — ADR-003)
model Lead {
  id String @id @default(cuid())

  // Identification cabinet
  raisonSociale String
  slug          String      @unique
  province      CrmProvince
  ville         String?
  regionBarreau String?
  langue        CrmLangue
  siteWeb       String?
  linkedinUrl   String?

  // Caractéristiques cabinet
  tailleCabinet     TailleCabinet
  domainesPratique  String[]
  modeFacturation   ModeFacturationCabinet?
  aTrustAccounting  Boolean                 @default(false)
  logicielActuel    String?
  volumeFacturation VolumeFacturation?
  nbAvocatsEstime   Int?
  nbAdjointsEstime  Int?

  // Pipeline
  sourceLead        SourceLead
  stageLead         StageLead         @default(AWARENESS)
  statutLead        StatutLead        @default(NURTURE_ONLY)
  modeleAdoption    ModeleAdoption?
  prioriteNurturing PrioriteNurturing @default(OBSERVATION)

  // Scoring 3 dimensions (0-100 total)
  score               Int @default(0)
  scoreFirmographique Int @default(0)
  scoreEngagement     Int @default(0)
  scoreEnrichissement Int @default(0)

  // Champion interne (adoption bottom-up)
  championInterneId String?
  championInterne   LeadContact? @relation("ChampionLead", fields: [championInterneId], references: [id])

  // Workspace
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  // Tags et notes
  tags         String[]
  notesPrivees String?

  // Conversion vers Cabinet (existant)
  convertedAt DateTime?
  cabinetId   String?      @unique
  cabinet     Cabinet?     @relation("CabinetLead", fields: [cabinetId], references: [id])
  raisonPerdu RaisonPerdu?

  // Lien pipeline Delivery (AuditSubmission existant)
  auditSubmissionId String?          @unique
  auditSubmission   AuditSubmission? @relation("AuditLead", fields: [auditSubmissionId], references: [id])

  // Relations CRM (1-to-1 vers entités delivery)
  bundleRecommendation BundleRecommendation?
  consultationPhase2   ConsultationPhase2?
  consultationDecision ConsultationDecision?
  activationChecklist  ActivationChecklist?

  // Relations 1-to-many
  contacts               LeadContact[]           @relation("LeadToContacts")
  activities             Activity[]
  tasks                  Task[]
  leadMagnetConsumptions LeadMagnetConsumption[]
  linkedInEngagements    LinkedInEngagement[]
  campaigns              Campaign[]              @relation("LeadCampaigns")

  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  dateDerniereActivite DateTime?

  @@index([stageLead])
  @@index([sourceLead])
  @@index([score])
  @@index([workspaceId])
}

// LeadContact : personne dans un cabinet prospect
model LeadContact {
  id     String @id @default(cuid())
  leadId String
  lead   Lead   @relation("LeadToContacts", fields: [leadId], references: [id], onDelete: Cascade)

  // Identité
  prenom          String
  nom             String
  titre           String?
  email           String?
  emailSecondaire String?
  emailStatut     EmailStatut  @default(NON_VERIFIE)
  sourceEmail     SourceEmail?
  linkedinUrl     String?
  telephone       String?
  languePref      CrmLangue    @default(FR)

  // Rôle CRM
  roleCrm                 RoleCrm
  estDecideur             Boolean @default(false)
  estChampionInterne      Boolean @default(false)
  estApprouveOperationnel Boolean @default(false)
  doNotContact            Boolean @default(false)

  // ADKAR tracking (intégré au contact, pas modèle séparé)
  awareness     NiveauAdkar  @default(NON_INITIE)
  desire        NiveauAdkar?
  knowledge     Int?
  ability       Int?
  reinforcement Boolean      @default(false)

  notes String?

  // Champion réciproque
  championOfLeads Lead[] @relation("ChampionLead")

  // Conversion vers User SAFE (à la signature)
  convertedAt DateTime?
  userId      String?   @unique
  user        User?     @relation("UserLeadContact", fields: [userId], references: [id])

  // Relations
  activities             Activity[]
  tasks                  Task[]
  leadMagnetConsumptions LeadMagnetConsumption[]
  linkedInEngagements    LinkedInEngagement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leadId])
  @@index([email])
}

// Activity : timeline unifiée (email, DM, call, meeting, note)
model Activity {
  id String @id @default(cuid())

  leadId     String?
  lead       Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contactId  String?
  contact    LeadContact? @relation(fields: [contactId], references: [id])
  campaignId String?
  campaign   Campaign?    @relation(fields: [campaignId], references: [id])

  type      TypeActivity
  direction CrmDirection
  sujet     String?
  contenu   String?

  statutEmail  StatutEmail?
  urlSource    String?
  attachements String[]

  dureeSecondes Int?
  scoreImpact   Int?

  date      DateTime @default(now())
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leadId, date])
  @@index([contactId, date])
  @@index([type])
}

// Task : tâche de prospection (distinct de DossierTache)
model Task {
  id        String       @id @default(cuid())
  leadId    String?
  lead      Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contactId String?
  contact   LeadContact? @relation(fields: [contactId], references: [id])

  type         TypeTaskCrm
  titre        String
  description  String?
  priorite     CrmPriorite   @default(NORMALE)
  statut       StatutTaskCrm @default(A_FAIRE)
  dateEcheance DateTime?
  dateClosed   DateTime?

  trigger TriggerTaskCrm?

  assigneeId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([statut, dateEcheance])
  @@index([leadId])
}

// Campaign : campagne marketing (LinkedIn, SEO, email, event)
model Campaign {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  nom              String
  canal            CanalCampaign
  description      String?
  dateDebut        DateTime
  dateFin          DateTime?
  budget           Float?
  cibleLeads       Int?
  cibleConversions Int?

  nbLeadsAttribues Int @default(0)
  nbConversions    Int @default(0)

  activities Activity[]
  leads      Lead[]     @relation("LeadCampaigns")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// LeadMagnet : checklist 8 points, playbook 30j, etc.
model LeadMagnet {
  id          String         @id @default(cuid())
  type        TypeLeadMagnet
  titre       String
  description String?
  contenuUrl  String?
