}

// ========== Journal général (registre central, append-only) ==========

enum JournalTransactionType {
  FACTURE
  PAIEMENT
  DEPOT_FIDEICOMMIS
  RETRAIT_FIDEICOMMIS
  DEBOURS
  DEPENSE
  AJUSTEMENT
  CORRECTION
}

enum JournalSourceModule {
  FACTURATION
  PAIEMENTS
  FIDEICOMMIS
  DEPENSES
  DEBOURS
  IMPORT_BANCAIRE
  AJUSTEMENT_MANUEL
  CORRECTION_SYSTEME
}

/// Journal général — append-only.
///
/// Idempotence structurelle: un index UNIQUE PARTIEL est maintenu hors-Prisma
/// sur (cabinetId, sourceModule, sourceId) WHERE sourceId IS NOT NULL.
/// Cf. migration `20260429120000_add_journal_idempotency_unique_index`.
///
/// Conséquences à respecter pour toute évolution de ce modèle :
///   - tout INSERT avec sourceId non null pour un triplet déjà présent → P2002.
///   - les lignes sans sourceId (ajustements manuels libres) restent autorisées.
///   - aucune mutation rétroactive: les corrections passent par une nouvelle
///     ligne `typeTransaction = CORRECTION`.
model JournalGeneralEntry {
  id              String                 @id @default(cuid())
  cabinetId       String
  dateTransaction DateTime
  typeTransaction JournalTransactionType
  reference       String?
  clientId        String?
  dossierId       String?
  description     String
  categorie       String?
  montantEntree   Float                  @default(0)
  montantSortie   Float                  @default(0)
  solde           Float                  @default(0)
  sourceModule    JournalSourceModule
  sourceId        String?
  utilisateurId   String?

  // ── CH-02 — champs du journal de caisse d'ADMINISTRATION ──────────────────
  // Art. 34 B-1 r.5 : pour chaque recette, le nom de la personne de qui la somme est
  // reçue, l'objet, et l'indication « espèces » ; pour chaque débours, le nom du
  // bénéficiaire. s. 18(5)(6) By-Law 9 ajoute l'identifiant du document utilisé.
  payerName          String?
  payeeName          String?
  purposeText        String?
  isCash             Boolean @default(false)
  documentIdentifier String?

  createdAt       DateTime               @default(now())

  cabinet     Cabinet  @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  client      Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  dossier     Dossier? @relation(fields: [dossierId], references: [id], onDelete: SetNull)
  utilisateur User?    @relation(fields: [utilisateurId], references: [id], onDelete: SetNull)

  @@index([cabinetId])
  @@index([cabinetId, dateTransaction])
  @@index([cabinetId, typeTransaction])
  @@index([clientId])
  @@index([dossierId])
  @@index([sourceModule])
  @@index([cabinetId, clientId, dateTransaction])
  @@map("journal_general")
}

// Verrou de période comptable (doctrine §9 — intégrité de période).
// Une période verrouillée refuse toute NOUVELLE écriture au journal datée dans ce
// mois (y compris les corrections : elles s'écrivent dans la période ouverte
// courante, jamais antidatées dans un mois clos). Posé automatiquement à la
// certification d'un rapprochement fidéicommis, ou manuellement (« clôturer le mois »).
model AccountingPeriodLock {
  id         String   @id @default(cuid())
  cabinetId  String
  periode    String // "YYYY-MM"
  lockedAt   DateTime @default(now())
  lockedById String?
  reason     String? // "reconciliation_certified" | "manual_close"

  cabinet Cabinet @relation(fields: [cabinetId], references: [id], onDelete: Cascade)

  @@unique([cabinetId, periode])
  @@index([cabinetId])
}

